{
  "name": "yakikotoba",
  "type": "module",
  "version": "1.0.0",
  "private": false,
  "description": "やきことば — 日本餐桌知识图鉴：烤肉、烧鸟、寿司与菜单日语",
  "license": "MIT",
  "homepage": "https://yakikotoba.pages.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xuing/yakikotoba.git"
  },
  "bugs": {
    "url": "https://github.com/xuing/yakikotoba/issues"
  },
  "keywords": [
    "japanese",
    "yakiniku",
    "yakitori",
    "sushi",
    "menu",
    "astro",
    "gemini"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "node scripts/check.mjs",
    "scan:data": "node scripts/build-scan-data.mjs",
    "tts": "node scripts/tts.mjs",
    "sample:menus": "node scripts/generate-sample-menus.mjs",
    "deploy": "astro build && wrangler pages deploy dist --project-name yakikotoba --branch main",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.4.0",
    "sharp": "^0.35.5",
    "wanakana": "^5.3.1",
    "yaml": "^2.9.1"
  }
}
