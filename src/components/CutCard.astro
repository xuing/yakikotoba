---
// Grid card: where it is (chart) + what it looks like (round photo) + the word.
import { Picture } from 'astro:assets';
import MapThumb from './MapThumb.astro';
import { photosFor } from '../lib/media';
import { cutUrl, locateCut, sectionOf, type Cut } from '../lib/content';
import { pick, type Locale } from '../i18n/ui';

interface Props { cut: Cut; locale: Locale; no?: number }
const { cut, locale, no } = Astro.props;
const d = cut.data;
const photo = photosFor(`cuts/${cut.id}`)[0];
const loc = (await locateCut(cut))[0];
const marker = loc?.markers[0];
const section = sectionOf(cut);
---
<a class="card cutcard" href={cutUrl(locale, cut)} data-section={section}>
  <div class:list={['media', { 'no-map': !loc, 'has-photo': !!photo }]}>
    {loc ? <MapThumb map={loc.map} x={marker?.x} y={marker?.y} /> : !photo && <span class="glyph mincho" lang="ja">{d.ja.slice(0, 1)}</span>}
    {photo && (
      <span class:list={['ph', { full: !loc }]}>
        <Picture src={photo.image} alt="" formats={['avif']} fallbackFormat="webp" widths={[160, 320, 480]} sizes={loc ? '96px' : '(max-width: 760px) 50vw, 260px'} loading="lazy" />
      </span>
    )}
  </div>
  <div class="text">
    {no != null && <span class="no num">No.{String(no).padStart(2, '0')}</span>}
    <span class="ja mincho" lang="ja">{d.ja}</span>
    {d.romaji && <span class="romaji">{d.romaji}</span>}
    <span class="name">{pick(d.name, locale)}</span>
  </div>
</a>

<style>
  .cutcard { display: flex; flex-direction: column; overflow: hidden; color: var(--ink); }
  .media { position: relative; background: var(--surface-2); padding: 14px 16px 10px; border-bottom: 1px solid var(--line); aspect-ratio: 16 / 10; display: grid; place-items: center; }
  .media :global(.thumb) { width: 100%; }
  .media.no-map { padding: 0; }
  .ph { position: absolute; right: 10px; bottom: 10px; width: 64px; height: 64px; border-radius: 50%; overflow: hidden; box-shadow: 0 0 0 3px var(--surface), var(--shadow-2); background: var(--surface); }
  .ph.full { inset: 0; width: 100%; height: 100%; border-radius: 0; box-shadow: none; }
  .ph :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .glyph { font-size: 64px; font-weight: 800; color: var(--line-2); }
  .text { display: grid; gap: 2px; padding: 12px 16px 16px; }
  .no { font-size: 11px; letter-spacing: .08em; color: var(--ink-3); }
  .ja { font-size: 23px; font-weight: 800; line-height: 1.3; letter-spacing: .02em; }
  .romaji { font-size: 14px; }
  .name { font-size: 14px; color: var(--ink-2); line-height: 1.5; margin-top: 4px; }
  @media (max-width: 520px) {
    .ja { font-size: 20px; }
    .ph { width: 52px; height: 52px; }
  }
</style>
