---
import MapThumb from './MapThumb.astro';
import { type Locale } from '../i18n/ui';
import { SECTIONS, cutsIn, sectionUrl } from '../lib/content';
import { hasMap } from '../lib/maps';

interface Props { locale: Locale }
const { locale } = Astro.props;
const sections = (await Promise.all(SECTIONS.map(async (s) => ({ s, cuts: await cutsIn(s.id), map: s.maps.find((m) => hasMap(m)) })))).filter((x) => x.cuts.length);
---
<div class="tiles">
  {sections.map(({ s, cuts, map }) => (
    <a class="card tile" href={sectionUrl(locale, s.id)} style={`--sec: var(--sec-${s.id})`}>
      <span class="art">{map ? <MapThumb map={map} /> : <span class="glyph mincho" lang="ja">他</span>}</span>
      <span class="txt">
        <span class="ja mincho" lang="ja">{s.ja}</span>
        <span class="nm">{locale === 'zh' ? s.zh : s.en}<span class="faint num"> · {cuts.length}</span></span>
        <span class="few" lang="ja">{cuts.slice(0, 5).map((c) => c.data.ja).join('・')}</span>
      </span>
    </a>
  ))}
</div>
<style>
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
  .tile { display: grid; grid-template-columns: 140px 1fr; gap: 18px; padding: 16px 18px; align-items: center; color: var(--ink); }
  .art { display: grid; place-items: center; min-height: 90px; }
  .glyph { font-size: 60px; font-weight: 800; color: var(--line-2); }
  .txt { display: grid; gap: 2px; min-width: 0; }
  .ja { font-size: 32px; font-weight: 800; line-height: 1.2; }
  .ja::after { content: ''; display: block; width: 24px; height: 3px; border-radius: 2px; background: var(--sec); margin: 7px 0 5px; }
  .nm { font-weight: 600; }
  .few { font-size: 13px; color: var(--ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (max-width: 420px) { .tile { grid-template-columns: 108px 1fr; gap: 14px; } .ja { font-size: 28px; } }
</style>
