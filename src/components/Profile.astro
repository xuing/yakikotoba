---
import { t, type Locale } from '../i18n/ui';
interface Props { profile?: { fat?: number; tenderness?: number; chew?: number; richness?: number }; locale: Locale }
const { profile, locale } = Astro.props;
const rows = (['fat', 'tenderness', 'chew', 'richness'] as const)
  .map((k) => ({ k, v: profile?.[k] }))
  .filter((r): r is { k: typeof r.k; v: number } => typeof r.v === 'number');
---
{rows.length > 0 && (
  <dl class="profile">
    {rows.map((r) => (
      <div class="row">
        <dt>{t(locale, `profile.${r.k}`)}</dt>
        <dd aria-label={`${r.v}/5`}>
          {[1, 2, 3, 4, 5].map((i) => <span class:list={['pip', { on: i <= Math.round(r.v) }]}></span>)}
        </dd>
      </div>
    ))}
  </dl>
)}
<style>
  .profile { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px 28px; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  dt { font-size: 14px; color: var(--ink-2); }
  dd { display: flex; gap: 4px; }
  .pip { width: 18px; height: 6px; border-radius: 3px; background: var(--line); }
  .pip.on { background: var(--ink); }
</style>
