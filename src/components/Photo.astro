---
// A credited photo. Raster images are optimised to AVIF/WebP; SVGs (logos) pass through.
import { Picture } from 'astro:assets';
import type { MediaItem } from '../lib/media';
interface Props { item: MediaItem; alt?: string; sizes?: string; widths?: number[]; credit?: boolean; loading?: 'lazy' | 'eager'; class?: string }
const { item, alt = '', sizes = '(max-width: 760px) 100vw, 560px', widths = [400, 720, 1080], credit = true, loading = 'lazy', class: cls } = Astro.props;
const caption = item.caption?.ja ?? item.caption?.zh ?? item.caption?.en;
const src = item.source;
---
<figure class:list={['photo', cls]}>
  {item.isSvg
    ? <img src={item.image.src} alt={alt} loading={loading} />
    : <Picture src={item.image} alt={alt} formats={['avif']} fallbackFormat="webp" widths={widths.filter((w) => w <= item.image.width * 1.05)} sizes={sizes} loading={loading} />}
  {(credit && (caption || src)) && (
    <figcaption>
      {caption && <span class="cap">{caption}</span>}
      {src && (
        <span class="credit" title={[src.title, src.author, src.license].filter(Boolean).join(" · ")}>
          出典：{src.url ? <a href={src.url} rel="noopener">{src.title ?? src.url}</a> : src.title}
          {src.author && <> · {src.author}</>}
          {src.license && <> · {src.license}</>}
        </span>
      )}
    </figcaption>
  )}
</figure>
<style>
  .photo { margin: 0; }
  .photo :global(img) { width: 100%; height: auto; border-radius: var(--radius-sm); background: var(--surface-2); }
  figcaption { margin-top: 6px; font-size: 11.5px; line-height: 1.6; color: var(--ink-3); display: grid; gap: 1px; min-width: 0; }
  .cap { color: var(--ink-2); font-size: 13px; }
  .credit { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .credit a { color: inherit; text-decoration-color: var(--line-2); text-underline-offset: 2px; }
  .credit a:hover { color: var(--ink-2); }
</style>
