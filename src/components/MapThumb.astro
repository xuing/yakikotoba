---
// Lightweight chart thumbnail: cached SVG image + one HTML dot for the cut.
import { mapSvg } from '../lib/maps';
interface Props { map: string; x?: number; y?: number }
const { map, x, y } = Astro.props;
const svg = mapSvg(map);
const [vx, vy, vw, vh] = svg ? svg.viewBox.split(/[\s,]+/).map(Number) : [0, 0, 1, 1];
const left = x != null ? ((x - vx) / vw) * 100 : null;
const top = y != null ? ((y - vy) / vh) * 100 : null;
---
{svg && (
  <span class="thumb" style={`aspect-ratio:${vw}/${vh}`}>
    <img src={`/maps/${map}.svg`} alt="" loading="lazy" decoding="async" />
    {left != null && top != null && <span class="pin" style={`left:${left}%;top:${top}%`}></span>}
  </span>
)}
<style>
  .thumb { position: relative; display: block; width: 100%; }
  img { width: 100%; height: 100%; }
  .pin {
    position: absolute; width: 11px; height: 11px; margin: -5.5px 0 0 -5.5px; border-radius: 50%;
    background: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent), 0 0 0 1.5px var(--surface) inset;
  }
</style>
