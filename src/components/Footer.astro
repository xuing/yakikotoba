---
import Seal from './Seal.astro';
import { href, t, type Locale } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<footer class="site-footer">
  <div class="wrap inner">
    <div class="brand">
      <Seal size={26} />
      <div>
        <div class="mincho name" lang="ja">やきことば</div>
        <div class="faint small">{t(locale, 'site.tagline')}</div>
      </div>
    </div>
    <p class="note">
      {t(locale, 'footer.sources')}
      <a href="https://www.maff.go.jp/j/pr/aff/2009/spe1_02.html" rel="noopener">maff.go.jp</a> ·
      <a href={href(locale, 'about')}>{t(locale, 'footer.credits')}</a>
    </p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); margin-top: 88px; padding-block: 36px 48px; }
  .inner { display: flex; gap: 24px 48px; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; }
  .brand { display: flex; gap: 12px; align-items: center; }
  .name { font-weight: 800; font-size: 17px; letter-spacing: .04em; }
  .small { font-size: 13px; }
  .note { max-width: 560px; font-size: 13px; color: var(--ink-3); line-height: 1.7; }
  .note a { color: var(--ink-2); }
</style>
