---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { htmlLang, locales, t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** current path without the locale prefix, e.g. "cuts/beef/misuji/" — used for the language switch */
  path?: string;
  nav?: string;
}
const { locale, title, description, path = '', nav } = Astro.props;
const siteName = t(locale, 'site.name');
const fullTitle = title ? `${title} · ${siteName}` : `${siteName} — ${t(locale, 'site.tagline')}`;
const desc = description ?? t(locale, 'site.description');
const altPath = (l: Locale) => `/${l}/${path.replace(/^\/+/, '')}`;
---
<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#f6f1e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131110" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(altPath(l), Astro.site)} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@1,6..72,400;1,6..72,500&family=Shippori+Mincho+B1:wght@500;700;800&display=swap"
    />
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <Header locale={locale} path={path} current={nav} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
