---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const {
  title = 'やきことば — 焼肉・焼き鳥・寿司のことば',
  description = '焼肉・焼き鳥・寿司のメニューの日本語：読み方、意味、部位、解説。烤肉、烤鸡串、寿司菜单上的日语。The Japanese on yakiniku, yakitori and sushi menus.',
} = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f1e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131110" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@1,6..72,400&family=Shippori+Mincho+B1:wght@600;800&display=swap" />
  </head>
  <body>
    <slot />
  </body>
</html>
