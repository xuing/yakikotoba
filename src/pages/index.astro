---
import Guide from '../layouts/Guide.astro';
import Icon from '../components/Icon.astro';
import EntryCard from '../components/EntryCard.astro';
import { categories, getGuide } from '../lib/guide';
const { tabs, entries } = await getGuide();
const find = (ref: string) => entries.find(e => e.ref === ref)!;
const featured = ['beef/karubi', 'maguro/otoro', 'chicken/negima', 'neta/hirame'].map(find);
const hero = find('chicken/negima');
const totalChains = new Set(tabs.flatMap(t => t.chains.map(c => c.id))).size;
---
<Guide>
  <div data-discover>
    <section class="hero container">
      <div class="hero-copy">
        <p class="eyebrow"><span class="tiny-line"></span><span class="i18n-zh">日本餐桌知识图鉴</span><span class="i18n-ja">日本の食卓・部位図鑑</span> <span class="eyebrow-en">A TASTE OF JAPAN</span></p>
        <h1>
          <span class="i18n-zh">每一口，<br />都有<span class="accent-word">新发现<svg viewBox="0 0 220 15" aria-hidden="true"><path d="M3 10C65 1 150 1 216 9M20 14c65-7 130-6 177-1" /></svg></span>。</span>
          <span class="i18n-ja">ひとくちに、<br />あたらしい<span class="accent-word">発見を<svg viewBox="0 0 220 15" aria-hidden="true"><path d="M3 10C65 1 150 1 216 9M20 14c65-7 130-6 177-1" /></svg></span>。</span>
        </h1>
        <p class="hero-description">
          <span class="i18n-zh">不止是读懂日语菜单。<br />从食材的来处，到好吃的门道，<br class="mobile-only" />把每一顿饭，变成一次小小的探索。</span>
          <span class="i18n-ja">単なるメニューの翻訳にとどまらず。<br />食材のルーツから、美味しさの秘密まで。<br class="mobile-only" />いつもの食事を、小さな探検に。</span>
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/scan/"><Icon name="camera" size={17} /> <span class="i18n-zh">拍照识菜单</span><span class="i18n-ja">メニューを撮って調べる</span></a>
          <a class="button button-outline" href="#topics"><span class="i18n-zh">开始探索</span><span class="i18n-ja">探索をはじめる</span> <Icon name="arrow" size={18} /></a>
          <a class="text-link" href="/menus/"><Icon name="book" size={17} /> <span class="i18n-zh">看懂菜单</span><span class="i18n-ja">メニュー図鑑</span></a>
        </div>
        <div class="hero-bottom">
          <span class="little-circle">知</span>
          <span><b>{entries.length}</b> <span class="i18n-zh">个知识词条</span><span class="i18n-ja">の知識エントリー</span></span>
          <i></i>
          <span><span class="i18n-zh">3 种餐桌场景</span><span class="i18n-ja">3つの食卓シーン</span></span>
          <i></i>
          <span><span class="i18n-zh">日语 × 生活知识</span><span class="i18n-ja">日本語 × 食文化の知恵</span></span>
        </div>
      </div>
      <div class="hero-visual">
        <a class="hero-image-link" href={hero.url} aria-label="认识鸡肉大葱串ねぎま"><img class="hero-image" src={hero.cover} width="720" height="480" alt="刷着酱汁、带着炭火焦香的鸡肉大葱串" fetchpriority="high" /><span class="photo-shade"></span><span class="hero-image-label"><span>焼き鳥の時間</span><small>YAKITORI · <span class="i18n-zh">日常里的小确幸</span><span class="i18n-ja">日常の小さな発見</span></small></span><span class="photo-arrow"><Icon name="diagonal" size={22} /></span></a>
        <span class="vertical-note" lang="ja">おいしい、その先を知る。</span>
        <a class="hero-note" href={hero.url}><span class="note-icon"><Icon name="spark" size={21} /></span><div><span class="note-eyebrow"><span class="i18n-zh">你知道吗？</span><span class="i18n-ja">知っていましたか？</span></span><p class="i18n-zh">「ねぎま」的「ま」，<br /><strong>最初指的竟然是金枪鱼。</strong></p><p class="i18n-ja">「ねぎま」の「ま」は、<br /><strong>実はもともと「マグロ」のこと。</strong></p></div><Icon name="diagonal" size={18} /></a>
        <span class="hero-caption">PHOTO: Ocdp / WIKIMEDIA COMMONS · CC0</span>
      </div>
    </section>

    <!-- AI Menu Scanner Feature Card -->
    <section class="scan-banner container">
      <div class="scan-banner-inner">
        <div class="scan-banner-content">
          <p class="eyebrow section-eyebrow"><Icon name="spark" size={14} /><span>GOOGLE GEMINI MULTIMODAL FEATURE</span></p>
          <h2>
            <span class="i18n-zh">看不懂菜单？拍张照，AI 瞬间读懂<span class="accent">。</span></span>
            <span class="i18n-ja">メニューを撮るだけ。AI が料理と部位を即座に解説<span class="accent">。</span></span>
          </h2>
          <p class="scan-banner-desc">
            <span class="i18n-zh">进店看到手写或竖排菜单不再困惑。Gemini 3.8 Flash 多模态视觉精准提取菜品名称与读音，直接匹配图鉴词条，部位解剖图、发音与背景故事立等可取。</span>
            <span class="i18n-ja">手書きや縦書きのメニューも安心。Gemini 3.8 Flash のマルチモーダルAIが文字を読み解き、{entries.length}の公式食材図鑑と連携して部位・発音・ストーリーをお届けします。</span>
          </p>
          <div class="scan-banner-cta">
            <a class="button button-primary" href="/scan/">
              <Icon name="camera" size={18} />
              <span class="i18n-zh">拍照识菜单</span><span class="i18n-ja">メニューを撮って調べる</span>
            </a>
            <span class="scan-banner-note">
              <span class="i18n-zh">※ 手机拍照或上传图片即可使用</span>
              <span class="i18n-ja">※ 写真を撮るかアップロードしてすぐ体験できます</span>
            </span>
          </div>
        </div>
        <div class="scan-banner-badge-box">
          <div class="scan-mini-mockup">
            <div class="mini-mock-head">
              <span class="dot"></span><span class="dot"></span><span class="dot"></span>
              <span class="mock-label"><span class="i18n-zh">AI 识别示例</span><span class="i18n-ja">AI 認識サンプル</span></span>
            </div>
            <div class="mini-mock-row matched">
              <span class="mock-tag"><span class="i18n-zh">图鉴收录</span><span class="i18n-ja">図鑑収録</span></span>
              <div class="mock-text">
                <strong>特選上カルビ</strong>
                <small>じょうかるび · <span class="i18n-zh">牛五花</span><span class="i18n-ja">牛バラ肉</span></small>
              </div>
              <span class="mock-link">→</span>
            </div>
            <div class="mini-mock-row matched">
              <span class="mock-tag"><span class="i18n-zh">图鉴收录</span><span class="i18n-ja">図鑑収録</span></span>
              <div class="mock-text">
                <strong>もも貴族焼</strong>
                <small>ももきぞくやき → ねぎま</small>
              </div>
              <span class="mock-link">→</span>
            </div>
            <div class="mini-mock-row ai">
              <span class="mock-tag ai"><span class="i18n-zh">AI 解析</span><span class="i18n-ja">AI 推定</span></span>
              <div class="mock-text">
                <strong>自家製ポテトサラダ</strong>
                <small><span class="i18n-zh">招牌手工前菜</span><span class="i18n-ja">名物手作り前菜</span></small>
              </div>
              <span class="mock-check">✓</span>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="topics-section container" id="topics">
      <div class="section-heading">
        <div>
          <p class="eyebrow section-eyebrow">FOLLOW YOUR APPETITE</p>
          <h2>
            <span class="i18n-zh">今天，想了解哪一味<span class="accent">？</span></span>
            <span class="i18n-ja">今日、どの味を知る<span class="accent">？</span></span>
          </h2>
        </div>
        <span class="section-aside">
          <span class="i18n-zh">从喜欢吃的开始，慢慢认识日本。</span>
          <span class="i18n-ja">好きな料理から、日本の食文化を広げよう。</span>
        </span>
      </div>
      <div class="topic-grid">
        {categories.map((c, i) => {
          const picture = find(c.cover);
          return <a class:list={['topic-card', c.color]} href={`/?view=atlas&category=${c.id}`}>
            <div class="topic-image"><img src={picture.cover} alt={c.title} width="720" height="480" loading="lazy" /><span class="topic-number">0{i + 1}</span><span class="topic-japanese" lang="ja">{c.ja}</span></div>
            <div class="topic-copy">
              <div>
                <p class="topic-english">{c.en}</p>
                <h3>
                  <span class="i18n-zh">{c.title}</span><span class="i18n-ja">{c.ja}</span>
                  <span class="topic-sub"><span class="i18n-zh">{c.ja}</span><span class="i18n-ja">{c.en}</span></span>
                </h3>
                <p class="topic-description"><span class="i18n-zh">{c.subtitle}</span><span class="i18n-ja">{c.subtitleJa}</span></p>
                <span class="topic-count">
                  {entries.filter(e => e.category === c.id).length} <span class="i18n-zh">个知识词条</span><span class="i18n-ja">件の知識</span>
                  <span>·</span>
                  {tabs.find(t => t.id === c.id)?.chains.length} <span class="i18n-zh">家店铺菜单</span><span class="i18n-ja">店舗メニュー</span>
                </span>
              </div>
              <span class="round-arrow"><Icon name="arrow" size={19} /></span>
            </div>
          </a>;
        })}
      </div>
    </section>
    <section class="stories-section container" id="stories">
      <div class="section-heading">
        <div>
          <p class="eyebrow section-eyebrow">A LITTLE KNOWLEDGE, A BETTER BITE</p>
          <h2>
            <span class="i18n-zh">好吃，也想知道为什么。</span>
            <span class="i18n-ja">美味しさの理由を、知る。</span>
          </h2>
        </div>
        <a class="text-link" href="/?view=atlas">
          <span class="i18n-zh">翻开全部图鉴</span><span class="i18n-ja">すべての図鑑を見る</span>
          <Icon name="arrow" size={17} />
        </a>
      </div>
      <div class="story-grid">{featured.map(e => <EntryCard entry={e} editorial />)}</div>
    </section>
    <section class="daily-section container">
      <div class="daily-kicker">
        <Icon name="spark" size={25} />
        <span>
          <span class="i18n-zh">每日一口</span><span class="i18n-ja">きょうの一口</span>
          <small>A BITE OF KNOWLEDGE</small>
        </span>
      </div>
      <div class="daily-question">
        <p>
          <span class="i18n-zh">吃起来像瘦肉的「ハラミ」，其实来自哪里？</span>
          <span class="i18n-ja">お肉のように見える「ハラミ」、実はどこの部位？</span>
        </p>
        <div class="quiz-options" data-quiz>
          <button type="button" data-answer="wrong"><span class="i18n-zh">牛的腿部</span><span class="i18n-ja">牛の脚</span></button>
          <button type="button" data-answer="correct"><span class="i18n-zh">牛的横膈膜</span><span class="i18n-ja">牛の横隔膜</span></button>
          <button type="button" data-answer="wrong"><span class="i18n-zh">牛的背部</span><span class="i18n-ja">牛の背中</span></button>
        </div>
        <p class="quiz-result" role="status" hidden></p>
      </div>
      <a class="daily-link" href="/learn/beef/harami/">
        <span class="i18n-zh">认识ハラミ</span><span class="i18n-ja">ハラミをもっと知る</span>
        <Icon name="arrow" size={18} />
      </a>
    </section>
    <section class="menu-promo container">
      <div>
        <p class="eyebrow section-eyebrow">THE MENU MAKES SENSE NOW</p>
        <h2>
          <span class="i18n-zh">同一种食材，<br />换家店就换了名字？</span>
          <span class="i18n-ja">同じ食材でも、<br />店が変われば名前も変わる？</span>
        </h2>
        <p>
          <span class="i18n-zh">从鸟贵族的「もも貴族焼」，认出熟悉的ねぎま。<br />对照 {totalChains} 家连锁店菜单，把知识带上餐桌。</span>
          <span class="i18n-ja">鳥貴族の「もも貴族焼」から、おなじみの「ねぎま」へ。<br />大手 {totalChains} 社のメニューと照らし合わせて、食卓を学びの場に。</span>
        </p>
        <a class="button button-dark" href="/menus/">
          <span class="i18n-zh">去看懂菜单</span><span class="i18n-ja">メニュー図鑑を見る</span>
          <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="menu-example">
        <span class="menu-example-top">
          <span class="i18n-zh">菜单上的名字 <Icon name="arrow" size={18} /> 你认识的食材</span>
          <span class="i18n-ja">メニューでの名前 <Icon name="arrow" size={18} /> 食材の部位</span>
        </span>
        <div>
          <span lang="ja">もも貴族焼<small><span class="i18n-zh">鳥貴族 · 招牌串烧</span><span class="i18n-ja">鳥貴族 · 名物串</span></small></span>
          <Icon name="arrow" />
          <span lang="ja">ねぎま<small><span class="i18n-zh">鸡肉大葱串</span><span class="i18n-ja">ねぎま串</span></small></span>
        </div>
        <div>
          <span lang="ja">三角（さんかく）<small><span class="i18n-zh">鳥貴族 · 店内叫法</span><span class="i18n-ja">鳥貴族 · 店内表記</span></small></span>
          <Icon name="arrow" />
          <span lang="ja">ぼんじり<small><span class="i18n-zh">鸡尾肉</span><span class="i18n-ja">ぼんじり</span></small></span>
        </div>
        <a href="/menus/">
          <span class="i18n-zh">读懂名字背后的食材 <Icon name="diagonal" size={16} /></span>
          <span class="i18n-ja">名前の裏の食材を知る <Icon name="diagonal" size={16} /></span>
        </a>
      </div>
    </section>
  </div>
  <section class="atlas-page container" data-atlas hidden>
    <p class="eyebrow section-eyebrow" data-atlas-eyebrow>YOUR JAPANESE FOOD FIELD GUIDE</p>
    <div class="section-heading atlas-heading">
      <div>
        <h1 data-atlas-title>
          <span class="i18n-zh">食材图鉴<span class="accent">。</span></span>
          <span class="i18n-ja">食材図鑑<span class="accent">。</span></span>
        </h1>
        <p data-atlas-description>
          <span class="i18n-zh">从菜单上的一个名字，找到食材、部位和背后的故事。</span>
          <span class="i18n-ja">メニューの料理名から、食材・部位・背景の物語へ。</span>
        </p>
      </div>
      <div class="atlas-stat"><strong data-visible-count>{entries.length}</strong><span><span class="i18n-zh">个知识词条</span><span class="i18n-ja">件の知識</span></span></div>
    </div>
    <div class="atlas-tools">
      <div class="category-tabs" aria-label="按场景筛选">
        <button type="button" class="selected" data-category-filter="all">
          <span class="i18n-zh">全部主题</span><span class="i18n-ja">すべて</span>
        </button>
        {categories.map(c => <button type="button" data-category-filter={c.id}>
          <Icon name={c.icon} size={17} />
          <span class="i18n-zh">{c.title}</span><span class="i18n-ja">{c.ja}</span>
        </button>)}
      </div>
      <label class="atlas-search">
        <Icon name="search" size={18} />
        <input type="search" placeholder="搜索食材、读音或部位…" data-placeholder-zh="搜索食材、读音或部位…" data-placeholder-ja="食材、読み方、部位で検索…" aria-label="筛选图鉴词条" data-atlas-search />
      </label>
    </div>
    <div class="atlas-summary" aria-live="polite">
      <span data-results-label>
        <span class="i18n-zh">全部知识</span><span class="i18n-ja">全知識</span>
      </span>
      <button type="button" data-clear-filters hidden>
        <span class="i18n-zh">清除筛选</span><span class="i18n-ja">絞り込み解除</span>
        <Icon name="close" size={13} />
      </button>
    </div>
    <div class="atlas-grid">{entries.map(e => <EntryCard entry={e} />)}</div>
    <div class="empty-state" data-empty hidden>
      <span class="empty-icon"><Icon name="bookmark" size={30} /></span>
      <h2 data-empty-title>
        <span class="i18n-zh">收藏你的第一口新知</span>
        <span class="i18n-ja">最初のお気に入りを保存</span>
      </h2>
      <p data-empty-description>
        <span class="i18n-zh">点击食材卡片上的书签，把想了解的知识留在这里。</span>
        <span class="i18n-ja">カードのしおりボタンを押して、気になる食材を保存しましょう。</span>
      </p>
      <a class="button button-primary" href="/?view=atlas">
        <span class="i18n-zh">去逛逛图鉴</span><span class="i18n-ja">図鑑をみる</span>
        <Icon name="arrow" size={17} />
      </a>
    </div>
  </section>
</Guide>
