---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';
import Ruby from '../components/Ruby.astro';
import AudioButton from '../components/AudioButton.astro';
import { getModel, type Tri } from '../lib/content';
import { allMedia, type MediaItem } from '../lib/media';
import { rubyToKana, hasKanji } from '../lib/ruby';

const tabs = await getModel();
const speak = (x: { ja: string; ruby?: string; kana?: string; tts?: string }) =>
  x.tts ?? (x.ruby ? rubyToKana(x.ruby) : hasKanji(x.ja) ? (x.kana ?? x.ja) : x.ja);
const credit = (m?: MediaItem) => [m?.caption?.ja, m?.source ? `出典：${[m.source.title, m.source.author, m.source.license].filter(Boolean).join(' · ')}` : ''].filter(Boolean).join(' / ');
// full-size versions for the thumbnail links
const full = new Map<string, string>();
for (const m of tabs.flatMap((t) => t.groups.flatMap((g) => g.rows.flatMap((r) => [r.photo, ...r.chains.map((h) => h.image)])))) {
  if (m && !full.has(m.path)) full.set(m.path, m.isSvg ? m.image.src : (await getImage({ src: m.image, width: Math.min(1400, m.image.width), format: 'webp' })).src);
}
const has = (t?: Tri) => !!(t && (t.ja || t.zh || t.en));

// image credits, grouped by source, for the footer
const sources = new Map<string, { title: string; url?: string; license?: string; n: number }>();
for (const m of allMedia()) {
  if (!m.source) continue;
  const key = m.source.url ?? m.source.title ?? '';
  const row = sources.get(key) ?? { title: m.source.title ?? key, url: m.source.url, license: m.source.license, n: 0 };
  row.n++;
  sources.set(key, row);
}
const COLS = [
  { ja: 'ことば', zh: '词', en: 'Word' },
  { ja: '意味', zh: '意思', en: 'Meaning' },
  { ja: '部位・正体', zh: '部位', en: 'What & where' },
  { ja: '解説', zh: '说明', en: 'Notes' },
];
---
<Base>
  <header class="top wrap">
    <a class="brand" href="/">
      <Seal size={34} />
      <span class="name mincho" lang="ja">やきことば</span>
    </a>
    <p class="tagline">
      <span lang="ja">焼肉・焼き鳥・寿司のことば</span>
      <span lang="zh-Hans">烤肉、烤鸡串、寿司菜单上的日语</span>
      <span lang="en">The Japanese of yakiniku, yakitori &amp; sushi</span>
    </p>
    <div class="langs" role="group" aria-label="表示言語">
      <span class="faint">表示</span>
      <label><input type="checkbox" data-lang-toggle="zh" checked /> 中文</label>
      <label><input type="checkbox" data-lang-toggle="en" checked /> EN</label>
    </div>
  </header>

  <nav class="tabs" role="tablist" aria-label="分類">
    <div class="wrap tabs-in">
      {tabs.map((t, i) => (
        <a role="tab" href={`#${t.id}`} data-tab={t.id} aria-selected={i === 0 ? 'true' : 'false'}>
          <span class="t-ja mincho" lang="ja"><Ruby text={t.ja} ruby={t.ruby} /></span>
          <span class="t-sub"><span lang="zh-Hans" class="zh">{t.zh}</span><span lang="en" class="en">{t.en}</span></span>
        </a>
      ))}
    </div>
  </nav>

  <main class="wrap">
    {tabs.map((t, i) => (
      <section class="panel" id={t.id} data-panel={t.id} role="tabpanel" hidden={i !== 0}>
        {t.chains.length > 0 && (
          <div class="filter">
            <span class="f-label"><span lang="ja">店で絞り込む</span><span lang="zh-Hans" class="zh">按店筛选</span><span lang="en" class="en">Filter by chain</span></span>
            <div class="chips">
              <button type="button" class="chip on" data-chain="">
                <span lang="ja">すべて</span>
              </button>
              {t.chains.map((c) => (
                <button type="button" class="chip" data-chain={c.id}>
                  {c.logo && <img src={c.logo.image.src} alt="" class="c-logo" />}
                  <span lang="ja">{c.ja}</span>
                  <span class="count num">{c.count}</span>
                </button>
              ))}
            </div>
            {t.chains.map((c) => (
              <div class="chain-info" data-chain-info={c.id} hidden>
                {c.logo && <span class="ci-logo"><img src={c.logo.image.src} alt={c.ja} /></span>}
                <div class="ci-text">
                  <p class="ci-name"><span class="mincho" lang="ja"><Ruby text={c.ja} ruby={c.ruby} /></span>{c.romaji && <span class="romaji">{c.romaji}</span>}</p>
                  {c.note?.ja && <p lang="ja">{c.note.ja}</p>}
                  {c.note?.zh && <p lang="zh-Hans" class="zh">{c.note.zh}</p>}
                  {c.note?.en && <p lang="en" class="en">{c.note.en}</p>}
                  {c.url && <p><a href={c.url} rel="noopener" class="ci-link">公式サイト ↗</a></p>}
                </div>
              </div>
            ))}
          </div>
        )}

        {t.groups.map((g) => (
          <section class="group" data-group>
            <h2 class="g-title">
              <span class="mincho" lang="ja">{g.ja}</span>
              <span lang="zh-Hans" class="zh">{g.zh}</span>
              <span lang="en" class="en">{g.en}</span>
            </h2>
            {has(g.note) && (
              <p class="g-note">
                {g.note?.ja && <span lang="ja">{g.note.ja}</span>}
                {g.note?.zh && <span lang="zh-Hans" class="zh">{g.note.zh}</span>}
                {g.note?.en && <span lang="en" class="en">{g.note.en}</span>}
              </p>
            )}
            <table class="tbl">
              <thead>
                <tr>
                  {COLS.map((c) => (
                    <th scope="col"><span lang="ja">{c.ja}</span><span lang="zh-Hans" class="zh">{c.zh}</span><span lang="en" class="en">{c.en}</span></th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {g.rows.map((r) => {
                  const it = r.item;
                  return (
                    <tr id={r.ref.replace('/', '-')} data-row={r.ref} data-chains={r.chains.map((h) => h.chain).join(' ')}>
                      <td class="c-word" data-label={COLS[0].ja}>
                        <div class="word">
                          {r.photo && (
                            <a class="pic pic-row" href={full.get(r.photo.path)} target="_blank" rel="noopener" title={credit(r.photo)}>
                              <Picture src={r.photo.image} alt={it.ja} formats={['avif']} fallbackFormat="webp" widths={[96, 192]} sizes="72px" loading="lazy" />
                            </a>
                          )}
                          <div class="w-text">
                            <span class="w-ja mincho" lang="ja"><Ruby text={it.ja} ruby={it.ruby} /></span>
                            {it.romaji && <span class="romaji">{it.romaji}</span>}
                          </div>
                          <AudioButton audioKey={`row:${r.ref}`} text={speak(it)} size="sm" />
                        </div>
                        {r.chains.map((h) => (
                          <div class="hit" data-hit={h.chain} hidden>
                            {h.image && (
                              <a class="pic pic-hit" href={full.get(h.image.path)} target="_blank" rel="noopener" title={credit(h.image)}>
                                <Picture src={h.image.image} alt={h.ja} formats={['avif']} fallbackFormat="webp" widths={[160, 320]} sizes="120px" loading="lazy" />
                              </a>
                            )}
                            <div class="h-text">
                              <span class="h-label">{h.signature ? '名物' : '店内表記'}</span>
                              <span class="h-ja mincho" lang="ja"><Ruby text={h.ja} ruby={h.ruby} /></span>
                              {h.romaji && <span class="romaji">{h.romaji}</span>}
                              {h.mean?.zh && <span lang="zh-Hans" class="zh">{h.mean.zh}</span>}
                              {h.mean?.en && <span lang="en" class="en">{h.mean.en}</span>}
                            </div>
                            <AudioButton audioKey={h.audioKey} text={speak(h)} size="sm" />
                          </div>
                        ))}
                      </td>
                      <td class:list={["c-mean", { empty: !has(it.mean) }]} data-label={COLS[1].ja}>
                        {it.mean?.ja && <p lang="ja" class="ja">{it.mean.ja}</p>}
                        {it.mean?.zh && <p lang="zh-Hans" class="zh">{it.mean.zh}</p>}
                        {it.mean?.en && <p lang="en" class="en">{it.mean.en}</p>}
                      </td>
                      <td class:list={["c-part", { empty: !has(it.part) }]} data-label={COLS[2].ja}>
                        {it.part?.ja && <p lang="ja" class="ja">{it.part.ja}</p>}
                        {it.part?.zh && <p lang="zh-Hans" class="zh">{it.part.zh}</p>}
                        {it.part?.en && <p lang="en" class="en">{it.part.en}</p>}
                      </td>
                      <td class:list={["c-note", { empty: !has(it.note) && !it.sources.length }]} data-label={COLS[3].ja}>
                        {it.note?.ja && <p lang="ja" class="ja">{it.note.ja}</p>}
                        {it.note?.zh && <p lang="zh-Hans" class="zh">{it.note.zh}</p>}
                        {it.note?.en && <p lang="en" class="en">{it.note.en}</p>}
                        {it.sources.length > 0 && (
                          <details class="src">
                            <summary>出典 · {it.sources.length}</summary>
                            <ol>{it.sources.map((s) => <li>{s.url ? <a href={s.url} rel="noopener">{s.title ?? s.url}</a> : s.title}</li>)}</ol>
                          </details>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </section>
        ))}
      </section>
    ))}
  </main>

  <footer class="foot wrap">
    <p><span lang="ja">写真の出典</span> · <span lang="zh-Hans" class="zh">图片来源</span> · <span lang="en" class="en">Image credits</span></p>
    <ul>
      {[...sources.values()].map((s) => (
        <li>{s.url ? <a href={s.url} rel="noopener">{s.title}</a> : s.title}{s.license && <span class="faint"> · {s.license}</span>}<span class="faint num"> · {s.n}</span></li>
      ))}
    </ul>
    <p class="faint small">発音：Gemini TTS</p>
  </footer>
</Base>

<script>
  // Tabs (hash), chain filter, and language toggles. Everything works without JS too (all panels just stay visible).
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];

  function showTab(id: string) {
    if (!panels.some((p) => p.dataset.panel === id)) id = panels[0]?.dataset.panel ?? '';
    for (const p of panels) p.hidden = p.dataset.panel !== id;
    for (const t of tabs) t.setAttribute('aria-selected', String(t.dataset.tab === id));
  }
  for (const t of tabs) {
    t.addEventListener('click', (e) => {
      e.preventDefault();
      history.replaceState(null, '', `#${t.dataset.tab}`);
      showTab(t.dataset.tab!);
    });
  }
  showTab(location.hash.slice(1));

  for (const panel of panels) {
    const chips = [...panel.querySelectorAll<HTMLButtonElement>('.chip[data-chain]')];
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const id = chip.dataset.chain ?? '';
        chips.forEach((c) => c.classList.toggle('on', c === chip));
        panel.querySelectorAll<HTMLElement>('[data-chain-info]').forEach((el) => (el.hidden = el.dataset.chainInfo !== id));
        panel.querySelectorAll<HTMLElement>('tr[data-row]').forEach((tr) => {
          const on = !id || (tr.dataset.chains ?? '').split(' ').includes(id);
          tr.hidden = !on;
          tr.querySelectorAll<HTMLElement>('[data-hit]').forEach((h) => (h.hidden = h.dataset.hit !== id));
          tr.classList.toggle('chain-on', !!id);
        });
        panel.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
          g.hidden = !g.querySelector('tr[data-row]:not([hidden])');
        });
      }),
    );
  }

  const root = document.documentElement;
  for (const box of document.querySelectorAll<HTMLInputElement>('[data-lang-toggle]')) {
    const lang = box.dataset.langToggle!;
    let off = false;
    try { off = localStorage.getItem(`hide-${lang}`) === '1'; } catch {}
    box.checked = !off;
    root.classList.toggle(`hide-${lang}`, off);
    box.addEventListener('change', () => {
      root.classList.toggle(`hide-${lang}`, !box.checked);
      try { localStorage.setItem(`hide-${lang}`, box.checked ? '0' : '1'); } catch {}
    });
  }
</script>

<style>
  /* header */
  .top { display: flex; align-items: center; gap: 14px 22px; flex-wrap: wrap; padding-block: 22px 16px; }
  .brand { display: inline-flex; align-items: center; gap: 11px; text-decoration: none; }
  .name { font-size: 26px; font-weight: 800; letter-spacing: .05em; }
  .tagline { display: flex; flex-direction: column; font-size: 13px; line-height: 1.5; color: var(--ink-2); flex: 1; min-width: 220px; }
  .tagline [lang='ja'] { color: var(--ink); font-size: 14px; }
  .langs { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--ink-2); }
  .langs label { display: inline-flex; align-items: center; gap: 5px; cursor: pointer; }
  .langs input { accent-color: var(--accent); }

  /* tabs */
  .tabs { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .tabs-in { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; }
  .tabs-in::-webkit-scrollbar { display: none; }
  [role='tab'] { display: grid; gap: 0; padding: 12px 18px 10px; text-decoration: none; color: var(--ink-3); border-bottom: 3px solid transparent; white-space: nowrap; transition: color .2s, border-color .2s; }
  [role='tab']:hover { color: var(--ink-2); }
  [role='tab'][aria-selected='true'] { color: var(--ink); border-bottom-color: var(--accent); }
  .t-ja { font-size: 22px; font-weight: 800; line-height: 1.5; }
  .t-ja :global(rt) { font-size: .45em; }
  .t-sub { display: flex; gap: 8px; font-size: 12px; }

  /* filter */
  .filter { margin-top: 22px; display: grid; gap: 10px; }
  .f-label { display: flex; gap: 10px; flex-wrap: wrap; align-items: baseline; font-size: 13px; color: var(--ink-2); }
  .f-label [lang='ja'] { color: var(--ink); font-weight: 600; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { cursor: pointer; display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); font-size: 14.5px; font-family: var(--font-ja); }
  .chip:hover { border-color: var(--line-2); }
  .chip.on { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .c-logo { height: 20px; width: auto; max-width: 64px; object-fit: contain; background: #fff; border-radius: 4px; padding: 1px 3px; }
  .count { font-size: 11px; color: var(--ink-3); }
  .chip.on .count { color: color-mix(in srgb, var(--bg) 70%, transparent); }
  .chain-info { display: flex; gap: 16px; align-items: flex-start; padding: 14px 16px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); }
  .chain-info[hidden] { display: none; }
  .ci-logo { width: 84px; height: 64px; display: grid; place-items: center; background: #fff; border-radius: 10px; border: 1px solid var(--line); padding: 8px; flex-shrink: 0; }
  .ci-logo img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .ci-text { display: grid; gap: 3px; font-size: 14px; }
  .ci-name { display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
  .ci-name .mincho { font-size: 20px; font-weight: 800; }
  .ci-link { color: var(--accent); text-decoration: none; font-size: 13px; }

  /* groups & table */
  .group { margin-top: 40px; }
  .group[hidden] { display: none; }
  .g-title { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; font-weight: 400; }
  .g-title .mincho { font-size: 26px; font-weight: 800; letter-spacing: .03em; }
  .g-title .zh, .g-title .en { font-size: 14px; color: var(--ink-2); }
  .g-note { display: grid; gap: 4px; font-size: 13.5px; line-height: 1.7; color: var(--ink-2); max-width: 64em; margin: 4px 0 14px; padding: 2px 0 2px 14px; border-left: 3px solid var(--line-2); }
  .g-note [lang='ja'] { color: var(--ink); }
  .tbl { width: 100%; border-collapse: collapse; table-layout: fixed; }
  thead th { text-align: left; vertical-align: bottom; padding: 8px 12px; border-bottom: 1.5px solid var(--ink); font-weight: 600; font-size: 13px; }
  thead th span { display: block; line-height: 1.4; }
  thead th .zh, thead th .en { font-weight: 400; font-size: 11.5px; color: var(--ink-3); }
  th:nth-child(1) { width: 25%; }
  th:nth-child(2) { width: 17%; }
  th:nth-child(3) { width: 19%; }
  td { vertical-align: top; padding: 14px 12px; border-bottom: 1px solid var(--line); }
  tr[hidden] { display: none; }
  td p { margin: 0; }
  td .ja { font-size: 14.5px; line-height: 1.75; color: var(--ink); }
  td .zh { font-size: 13.5px; line-height: 1.7; color: var(--ink-2); margin-top: 3px; }
  td .en { font-size: 13px; line-height: 1.55; color: var(--ink-2); margin-top: 3px; }
  .c-note .ja { font-size: 14px; }
  .c-mean .ja { font-weight: 600; }
  .src { font-size: 11.5px; color: var(--ink-3); margin-top: 8px; line-height: 1.6; }
  .src summary { cursor: pointer; width: fit-content; list-style: none; padding: 1px 8px; border: 1px solid var(--line); border-radius: 999px; }
  .src summary::-webkit-details-marker { display: none; }
  .src[open] summary { color: var(--ink-2); border-color: var(--line-2); }
  .src ol { margin: 6px 0 0; padding-left: 1.4em; display: grid; gap: 2px; }
  .src a { color: inherit; text-underline-offset: 2px; text-decoration-color: var(--line-2); }

  .word { display: flex; align-items: center; gap: 12px; }
  .w-text { display: grid; gap: 1px; flex: 1; min-width: 0; }
  .w-ja { font-size: 23px; font-weight: 800; line-height: 1.45; letter-spacing: .02em; }
  .w-ja :global(rt) { font-size: .45em; }
  .romaji { font-size: 14.5px; }
  .pic { display: block; flex-shrink: 0; border-radius: 10px; overflow: hidden; background: var(--surface-2); }
  .pic :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .pic-row { width: 64px; height: 64px; }
  .chain-on .pic-row { display: none; }
  .hit { display: flex; gap: 12px; align-items: center; margin-top: 10px; padding: 10px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); }
  .hit[hidden] { display: none; }
  .pic-hit { width: 96px; height: 96px; background: var(--surface-2); }
  .pic-hit :global(img) { object-fit: contain; }
  .h-text { display: grid; gap: 1px; flex: 1; min-width: 0; font-size: 12.5px; }
  .h-label { font-size: 11px; color: var(--accent); font-weight: 700; letter-spacing: .06em; }
  .h-ja { font-size: 16px; font-weight: 800; line-height: 1.5; }
  .h-text .romaji { font-size: 13px; }

  /* language toggles */
  :global(html.hide-zh) .zh, :global(html.hide-zh) [lang='zh-Hans']:not(html) { display: none !important; }
  :global(html.hide-en) .en, :global(html.hide-en) [lang='en']:not(html) { display: none !important; }

  /* footer */
  .foot { margin-top: 72px; padding-block: 28px 56px; border-top: 1px solid var(--line); font-size: 13px; color: var(--ink-2); display: grid; gap: 10px; }
  .foot ul { padding-left: 1.2em; display: grid; gap: 3px; }
  .foot a { color: var(--ink-2); }
  .small { font-size: 12px; }

  @media (max-width: 860px) {
    thead { display: none; }
    .tbl, .tbl tbody, .tbl tr, .tbl td { display: block; width: 100%; }
    .tbl tr { padding: 14px 0 12px; border-bottom: 1px solid var(--line); }
    .tbl td { border: 0; padding: 0; }
    .tbl td.c-word { margin-bottom: 8px; }
    .tbl td.empty { display: none; }
    .tbl td:not(.c-word) { display: grid; grid-template-columns: 4.2em minmax(0, 1fr); column-gap: 10px; padding: 3px 0; }
    .tbl td:not(.c-word)::before { content: attr(data-label); grid-row: 1 / span 4; font-size: 11px; line-height: 2.1; letter-spacing: .04em; color: var(--ink-3); font-weight: 600; }
    .tbl td:not(.c-word) > * { grid-column: 2; }
    td .zh, td .en { margin-top: 1px; }
    .w-ja { font-size: 24px; }
    .pic-row { width: 56px; height: 56px; }
    [role='tab'] { padding: 10px 12px 8px; }
    .t-ja { font-size: 20px; }
  }
</style>
