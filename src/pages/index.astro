---
// Root: send the visitor to their language.
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>やきことば · Yaki Kotoba</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta http-equiv="refresh" content="1; url=/zh/" />
    <script is:inline>
      var l = (navigator.languages || [navigator.language || '']).join(',').toLowerCase();
      location.replace(/(^|,)zh/.test(l) ? '/zh/' : /(^|,)en/.test(l) ? '/en/' : '/zh/');
    </script>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: system-ui, sans-serif; background: #f6f1e8; color: #1d1a16; }
      a { color: inherit; margin: 0 .6em; }
      @media (prefers-color-scheme: dark) { body { background: #131110; color: #f1eae0; } }
    </style>
  </head>
  <body>
    <p><a href="/zh/">中文</a> · <a href="/en/">English</a></p>
  </body>
</html>
