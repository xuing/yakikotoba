---
import Base from '../../../layouts/Base.astro';
import Ruby from '../../../components/Ruby.astro';
import AudioButton from '../../../components/AudioButton.astro';
import { locales, pick, t, href, type Locale } from '../../../i18n/ui';
import { getTerms, TERM_CATEGORIES } from '../../../lib/content';
import { rubyToKana } from '../../../lib/ruby';

export const getStaticPaths = () => locales.map((lang) => ({ params: { lang } }));
const locale = Astro.params.lang as Locale;
const terms = await getTerms();
const known = new Set<string>(TERM_CATEGORIES);
const groups = TERM_CATEGORIES.map((c) => ({ c, list: terms.filter((x) => (known.has(x.data.category) ? x.data.category : 'other') === c) })).filter((g) => g.list.length);
---
<Base locale={locale} title={t(locale, 'words.title')} path="words/" nav="words">
  <div class="wrap page">
    <header class="head">
      <h1 class="mincho">{t(locale, 'words.title')}</h1>
      <p class="muted">{t(locale, 'words.lead')}</p>
      <nav class="jump">{groups.map((g) => <a class="chip" href={`#cat-${g.c}`}>{t(locale, `cat.${g.c}` as any)}<span class="faint num">{g.list.length}</span></a>)}</nav>
    </header>
    {groups.map((g) => (
      <section class="group" id={`cat-${g.c}`}>
        <div class="section-title"><h2>{t(locale, `cat.${g.c}` as any)}</h2></div>
        <div class="list">
          {g.list.map((x) => {
            const d = x.data;
            const examples = d.examples.map((e) => (typeof e === 'string' ? e : e.ja));
            return (
              <article class="term card" id={x.id}>
                <div class="top">
                  <AudioButton audioKey={`term:${x.id}`} text={d.tts ?? d.kana ?? (d.ruby ? rubyToKana(d.ruby) : d.ja)} locale={locale} size="sm" />
                  <div class="word">
                    <span class="ja mincho" lang="ja"><Ruby text={d.ja} ruby={d.ruby} /></span>
                    {d.romaji && <span class="romaji">{d.romaji}{d.position && d.position !== 'word' && <span class="pos">{d.position === 'prefix' ? `${d.ja}〜` : `〜${d.ja}`}</span>}</span>}
                  </div>
                </div>
                <p class="mean">{pick(d.name, locale)}</p>
                {d.summary && <p class="sum">{pick(d.summary, locale)}</p>}
                {d.kanjiParts.length > 0 && (
                  <ul class="kanji">
                    {d.kanjiParts.map((k) => (
                      <li><span class="k mincho" lang="ja">{k.char}</span><span class="kr" lang="ja">{k.reading}</span><span class="km">{locale === 'zh' ? k.zh ?? k.en : k.en ?? k.zh}</span></li>
                    ))}
                  </ul>
                )}
                {d.pitfall && <p class="pit">{pick(d.pitfall, locale)}</p>}
                {examples.length > 0 && <p class="ex">{examples.map((e) => <a class="chip" href={`${href(locale, 'search')}?q=${encodeURIComponent(e)}`} lang="ja">{e}</a>)}</p>}
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Base>
<style>
  .page { padding-top: 34px; }
  .head { margin-bottom: 26px; display: grid; gap: 10px; }
  h1 { font-size: clamp(34px, 5vw, 48px); font-weight: 800; letter-spacing: .03em; }
  .jump { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .jump .faint { font-size: 12px; }
  .group { margin-top: 36px; scroll-margin-top: 80px; }
  .list { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
  .term { padding: 16px 18px; display: grid; gap: 8px; align-content: start; scroll-margin-top: 90px; }
  .term:target { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .top { display: flex; align-items: center; gap: 12px; }
  .word { display: grid; min-width: 0; }
  .ja { font-size: 24px; font-weight: 800; line-height: 1.5; }
  .romaji { font-size: 14px; display: flex; gap: 10px; align-items: baseline; }
  .pos { font-style: normal; font-family: var(--font-ja); font-size: 12px; color: var(--ink-3); border: 1px solid var(--line); border-radius: 5px; padding: 0 5px; }
  .mean { font-weight: 600; }
  .sum { font-size: 14.5px; color: var(--ink-2); }
  .kanji { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .kanji li { display: inline-flex; align-items: baseline; gap: 6px; background: var(--surface-2); border: 1px solid var(--line); border-radius: 8px; padding: 2px 9px; font-size: 13px; }
  .k { font-size: 18px; font-weight: 700; }
  .kr { color: var(--ink-2); }
  .km { color: var(--ink-3); }
  .pit { font-size: 13.5px; color: var(--accent); background: var(--accent-soft); border-radius: 8px; padding: 6px 10px; }
  .ex { display: flex; flex-wrap: wrap; gap: 6px; }
  .ex .chip { font-size: 13px; }
</style>
