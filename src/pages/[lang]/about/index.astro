---
import Base from '../../../layouts/Base.astro';
import { locales, t, type Locale } from '../../../i18n/ui';
import { allMedia } from '../../../lib/media';

export const getStaticPaths = () => locales.map((lang) => ({ params: { lang } }));
const locale = Astro.params.lang as Locale;
const media = allMedia();
// group credits by source
const bySource = new Map<string, { title: string; url?: string; license?: string; author?: string; files: string[] }>();
for (const m of media) {
  const key = `${m.source?.url ?? ''}|${m.source?.title ?? ''}|${m.source?.author ?? ''}`;
  const row = bySource.get(key) ?? { title: m.source?.title ?? m.source?.url ?? '—', url: m.source?.url, license: m.source?.license, author: m.source?.author, files: [] };
  row.files.push(m.path);
  bySource.set(key, row);
}
const zh = locale === 'zh';
---
<Base locale={locale} title={t(locale, 'about.title')} path="about/" nav="about">
  <div class="wrap page">
    <h1 class="mincho">{t(locale, 'about.title')}</h1>
    <div class="prose">
      <p>{zh ? 'やきことば 是一本学习用的图鉴：日本焼肉、焼き鳥（含焼きとん）菜单上的词怎么读、什么意思、为什么这么叫，那块肉在动物身上的哪里、长什么样。' : 'Yaki Kotoba is a study guide to the words on Japanese yakiniku and yakitori (and yakiton) menus: how to read them, what they mean, why they are called that, where the cut sits on the animal and what it looks like.'}</p>
      <p>{zh ? '部位图与大部分实拍图来自农林水产省 aff 2020 年 9 月号「牛、豚、鶏の部位を徹底解説！お肉丸わかり図鑑」（监修：日本食肉消費総合センター），依照政府标准利用规约使用并注明出处。连锁店的 logo 与菜品图来自各店官网。发音由 Gemini TTS 生成。' : 'Cut charts and most photos come from MAFF’s aff magazine (Sept 2020, “お肉丸わかり図鑑”, supervised by the Japan Meat Information Service Center), used under the Government of Japan Standard Terms of Use with attribution. Chain logos and dish photos are from each chain’s official site. Audio is generated with Gemini TTS.'}</p>
    </div>
    <h2 class="eyebrow">{t(locale, 'footer.credits')} · {media.length}</h2>
    <ul class="credits">
      {[...bySource.values()].map((r) => (
        <li>
          <div class="src">{r.url ? <a href={r.url} rel="noopener">{r.title}</a> : r.title}{r.author && <span class="faint"> · {r.author}</span>}{r.license && <span class="faint"> · {r.license}</span>}</div>
          <div class="files faint">{r.files.length} · {r.files.slice(0, 8).join(', ')}{r.files.length > 8 ? ' …' : ''}</div>
        </li>
      ))}
    </ul>
  </div>
</Base>
<style>
  .page { padding-top: 34px; max-width: 860px; }
  h1 { font-size: clamp(34px, 5vw, 48px); font-weight: 800; margin-bottom: 18px; }
  .prose { display: grid; gap: 14px; font-size: 16px; color: var(--ink-2); margin-bottom: 40px; }
  .credits { list-style: none; padding: 0; margin-top: 12px; border-top: 1px solid var(--line); }
  .credits li { padding: 12px 0; border-bottom: 1px solid var(--line); display: grid; gap: 4px; font-size: 14px; }
  .credits a { color: var(--ink); }
  .files { font-size: 12px; word-break: break-all; }
</style>
