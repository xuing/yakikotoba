---
import Base from '../../../layouts/Base.astro';
import Ruby from '../../../components/Ruby.astro';
import AudioButton from '../../../components/AudioButton.astro';
import { locales, pick, t, type Locale } from '../../../i18n/ui';
import { getPhraseScenes } from '../../../lib/content';
import { rubyToKana } from '../../../lib/ruby';

export const getStaticPaths = () => locales.map((lang) => ({ params: { lang } }));
const locale = Astro.params.lang as Locale;
const scenes = await getPhraseScenes();
---
<Base locale={locale} title={t(locale, 'phrases.title')} path="phrases/" nav="phrases">
  <div class="wrap page">
    <header class="head">
      <h1 class="mincho">{t(locale, 'phrases.title')}</h1>
      <p class="muted">{t(locale, 'phrases.lead')}</p>
      <nav class="jump">{scenes.map((s) => <a class="chip" href={`#${s.id}`}>{pick(s.data.title, locale)}</a>)}</nav>
    </header>
    {scenes.map((s) => (
      <section class="scene" id={s.id}>
        <div class="section-title"><h2>{pick(s.data.title, locale)}</h2></div>
        <ol class="list">
          {s.data.phrases.map((p) => (
            <li class="phrase" id={`${s.id}-${p.id}`}>
              <AudioButton audioKey={`phrase:${s.id}/${p.id}`} text={p.tts ?? p.kana ?? (p.ruby ? rubyToKana(p.ruby) : p.ja)} locale={locale} />
              <div class="txt">
                <p class="ja mincho" lang="ja"><Ruby text={p.ja} ruby={p.ruby} /></p>
                {p.romaji && <p class="romaji">{p.romaji}</p>}
                <p class="tr">{locale === 'zh' ? p.zh ?? p.en : p.en ?? p.zh}</p>
                {p.note && <p class="note">{pick(p.note, locale)}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Base>
<style>
  .page { padding-top: 34px; }
  .head { margin-bottom: 18px; display: grid; gap: 10px; }
  h1 { font-size: clamp(34px, 5vw, 48px); font-weight: 800; letter-spacing: .03em; }
  .jump { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .scene { margin-top: 40px; scroll-margin-top: 80px; }
  .list { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .phrase { display: flex; gap: 16px; align-items: flex-start; padding: 18px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 90px; }
  .txt { display: grid; gap: 3px; min-width: 0; }
  .ja { font-size: clamp(20px, 2.6vw, 24px); font-weight: 700; line-height: 1.9; }
  .romaji { font-size: 15px; }
  .tr { font-size: 15.5px; margin-top: 2px; }
  .note { font-size: 13.5px; color: var(--ink-3); margin-top: 4px; padding-left: 10px; border-left: 2px solid var(--line-2); }
</style>
