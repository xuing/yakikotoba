---
import Base from '../../../layouts/Base.astro';
import Ruby from '../../../components/Ruby.astro';
import AudioButton from '../../../components/AudioButton.astro';
import Photo from '../../../components/Photo.astro';
import { locales, pick, t, type Locale } from '../../../i18n/ui';
import { getDishes, getCut, cutUrl, DISH_CATEGORIES } from '../../../lib/content';
import { photosFor } from '../../../lib/media';
import { rubyToKana } from '../../../lib/ruby';

export const getStaticPaths = () => locales.map((lang) => ({ params: { lang } }));
const locale = Astro.params.lang as Locale;
const dishes = await getDishes();
const known = new Set<string>(DISH_CATEGORIES);
const groups = DISH_CATEGORIES.map((c) => ({ c, list: dishes.filter((x) => (known.has(x.data.category) ? x.data.category : 'other') === c) })).filter((g) => g.list.length);
const cutsOf = async (refs: string[]) => (await Promise.all(refs.map((r) => getCut(r)))).filter((c): c is NonNullable<typeof c> => !!c);
const enriched = await Promise.all(groups.map(async (g) => ({ ...g, list: await Promise.all(g.list.map(async (x) => ({ x, cuts: await cutsOf(x.data.cuts), photo: photosFor(`dishes/${x.id}`)[0] }))) })));
---
<Base locale={locale} title={t(locale, 'dishes.title')} path="dishes/" nav="dishes">
  <div class="wrap page">
    <header class="head">
      <h1 class="mincho">{t(locale, 'dishes.title')}</h1>
      <p class="muted">{t(locale, 'dishes.lead')}</p>
      <nav class="jump">{enriched.map((g) => <a class="chip" href={`#cat-${g.c}`}>{t(locale, `cat.${g.c}` as any)}<span class="faint num">{g.list.length}</span></a>)}</nav>
    </header>
    {enriched.map((g) => (
      <section class="group" id={`cat-${g.c}`}>
        <div class="section-title"><h2>{t(locale, `cat.${g.c}` as any)}</h2></div>
        <div class="list">
          {g.list.map(({ x, cuts, photo }) => {
            const d = x.data;
            return (
              <article class="dish card" id={x.id}>
                {photo && <Photo item={photo} locale={locale} alt={d.ja} widths={[360, 720]} sizes="(max-width: 760px) 100vw, 360px" class="d-img" />}
                <div class="body">
                  <div class="top">
                    <AudioButton audioKey={`dish:${x.id}`} text={d.tts ?? d.kana ?? (d.ruby ? rubyToKana(d.ruby) : d.ja)} locale={locale} size="sm" />
                    <div class="word">
                      <span class="ja mincho" lang="ja"><Ruby text={d.ja} ruby={d.ruby} /></span>
                      {d.romaji && <span class="romaji">{d.romaji}</span>}
                    </div>
                  </div>
                  <p class="mean">{pick(d.name, locale)}</p>
                  {d.summary && <p class="sum">{pick(d.summary, locale)}</p>}
                  {d.etymology && <p class="sum ety">{pick(d.etymology, locale)}</p>}
                  {d.kanjiParts.length > 0 && (
                    <ul class="kanji">
                      {d.kanjiParts.map((k) => <li><span class="k mincho" lang="ja">{k.char}</span><span class="kr" lang="ja">{k.reading}</span><span class="km">{locale === 'zh' ? k.zh ?? k.en : k.en ?? k.zh}</span></li>)}
                    </ul>
                  )}
                  {cuts.length > 0 && <p class="cuts">{cuts.map((c) => <a class="chip" href={cutUrl(locale, c)}><span lang="ja">{c.data.ja}</span><span class="faint">{pick(c.data.name, locale)}</span></a>)}</p>}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Base>
<style>
  .page { padding-top: 34px; }
  .head { margin-bottom: 26px; display: grid; gap: 10px; }
  h1 { font-size: clamp(34px, 5vw, 48px); font-weight: 800; letter-spacing: .03em; }
  .jump { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .jump .faint { font-size: 12px; }
  .group { margin-top: 36px; scroll-margin-top: 80px; }
  .list { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; align-items: start; }
  .dish { overflow: hidden; scroll-margin-top: 90px; }
  .dish:target { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .dish :global(.d-img img) { border-radius: 0; aspect-ratio: 3 / 2; object-fit: cover; }
  .dish :global(.d-img figcaption) { padding: 0 16px; }
  .body { padding: 16px 18px; display: grid; gap: 8px; }
  .top { display: flex; align-items: center; gap: 12px; }
  .word { display: grid; min-width: 0; }
  .ja { font-size: 23px; font-weight: 800; line-height: 1.5; }
  .romaji { font-size: 14px; }
  .mean { font-weight: 600; }
  .sum { font-size: 14.5px; color: var(--ink-2); }
  .ety { color: var(--ink-3); font-size: 13.5px; }
  .kanji { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .kanji li { display: inline-flex; align-items: baseline; gap: 6px; background: var(--surface-2); border: 1px solid var(--line); border-radius: 8px; padding: 2px 9px; font-size: 13px; }
  .k { font-size: 18px; font-weight: 700; }
  .kr { color: var(--ink-2); }
  .km { color: var(--ink-3); }
  .cuts { display: flex; flex-wrap: wrap; gap: 6px; }
</style>
