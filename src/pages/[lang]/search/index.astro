---
import Base from '../../../layouts/Base.astro';
import { locales, t, type Locale } from '../../../i18n/ui';

export const getStaticPaths = () => locales.map((lang) => ({ params: { lang } }));
const locale = Astro.params.lang as Locale;
const labels = {
  cut: locale === 'zh' ? '部位' : 'Cut',
  term: locale === 'zh' ? '用语' : 'Word',
  dish: locale === 'zh' ? '菜品' : 'Dish',
  chain: locale === 'zh' ? '连锁店' : 'Chain',
  item: locale === 'zh' ? '店铺菜单' : 'Chain menu',
  phrase: locale === 'zh' ? '会话' : 'Phrase',
};
---
<Base locale={locale} title={t(locale, 'nav.search')} path="search/" nav="search">
  <div class="wrap page">
    <yk-search data-locale={locale} data-labels={JSON.stringify(labels)} data-none={t(locale, 'search.none')} data-unknown={t(locale, 'search.unknown')}>
      <form class="box" role="search" action="" method="get">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg>
        <input name="q" type="search" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder={t(locale, 'search.placeholder')} aria-label={t(locale, 'nav.search')} autofocus />
      </form>
      <p class="hint faint">{t(locale, 'search.hint')}</p>
      <section class="breakdown" hidden>
        <h2 class="eyebrow">{t(locale, 'search.breakdown')}</h2>
        <div class="tokens"></div>
      </section>
      <section class="results-wrap" hidden>
        <h2 class="eyebrow">{t(locale, 'search.results')}</h2>
        <ul class="results"></ul>
      </section>
      <p class="none faint" hidden>{t(locale, 'search.none')}</p>
    </yk-search>
  </div>
</Base>

<script>
  import { toHiragana, isRomaji } from 'wanakana';

  type Entry = { t: string; u: string; ja: string; ruby?: string; kana?: string; ro?: string; zh?: string; en?: string; al?: string[]; sub?: string; seg?: 1 };

  const PUNCT = /[\s・･〜~\-‐－—「」『』（）()［］\[\]【】、。,.!！?？:：/／'"“”]/g;
  const kataToHira = (s: string) => s.replace(/[ァ-ヶ]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0x60));
  const norm = (s = '') => kataToHira(s.normalize('NFKC').toLowerCase().replace(PUNCT, ''));
  const deMacron = (s = '') => s.normalize('NFKD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z]/g, '');
  const esc = (s = '') => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const ruby = (e: { ja: string; ruby?: string }) =>
    e.ruby ? esc(e.ruby).replace(/\{([^|{}]+)\|([^{}]+)\}/g, '<ruby>$1<rt>$2</rt></ruby>') : esc(e.ja);
  const RANK: Record<string, number> = { cut: 0, term: 1, dish: 2, item: 3, chain: 4, phrase: 5 };

  class YkSearch extends HTMLElement {
    entries: Entry[] = [];
    dict = new Map<string, Entry[]>();
    maxLen = 1;
    locale = 'zh';
    input!: HTMLInputElement;

    async connectedCallback() {
      this.locale = this.dataset.locale ?? 'zh';
      this.input = this.querySelector('input')!;
      const q = new URLSearchParams(location.search).get('q') ?? '';
      this.input.value = q;
      this.querySelector('form')!.addEventListener('submit', (e) => e.preventDefault());
      let timer = 0;
      this.input.addEventListener('input', () => {
        clearTimeout(timer);
        timer = window.setTimeout(() => this.run(), 90);
      });
      this.entries = await fetch('/search.json').then((r) => r.json());
      for (const e of this.entries) {
        if (!e.seg) continue;
        for (const s of [e.ja, e.kana, ...(e.t === 'cut' ? (e.al ?? []).filter((a) => /[぀-ヿ一-鿿]/.test(a) && a.length <= 6) : [])]) {
          const k = norm(s);
          if (!k) continue;
          const list = this.dict.get(k) ?? [];
          if (!list.includes(e)) list.push(e);
          this.dict.set(k, list);
          this.maxLen = Math.max(this.maxLen, k.length);
        }
      }
      for (const list of this.dict.values()) list.sort((a, b) => RANK[a.t] - RANK[b.t]);
      this.run();
    }

    url(e: Entry) {
      return `/${this.locale}/${e.u}`;
    }
    meaning(e: Entry) {
      return (this.locale === 'zh' ? e.zh ?? e.en : e.en ?? e.zh) ?? '';
    }

    run() {
      const raw = this.input.value.trim();
      const url = new URL(location.href);
      raw ? url.searchParams.set('q', raw) : url.searchParams.delete('q');
      history.replaceState(null, '', url);
      const wrap = this.querySelector<HTMLElement>('.results-wrap')!;
      const none = this.querySelector<HTMLElement>('.none')!;
      const bd = this.querySelector<HTMLElement>('.breakdown')!;
      if (!raw) {
        wrap.hidden = none.hidden = bd.hidden = true;
        return;
      }
      const q = norm(raw);
      const ascii = /^[a-z\s'āīūēōâîûêô-]+$/i.test(raw);
      const qKana = ascii && isRomaji(raw.replace(/[āīūēō]/g, (c) => ({ ā: 'aa', ī: 'ii', ū: 'uu', ē: 'ee', ō: 'ou' })[c]!)) ? norm(toHiragana(raw)) : '';
      const qRo = deMacron(raw);
      const scored: { e: Entry; s: number }[] = [];
      for (const e of this.entries) {
        let s = 0;
        const ja = norm(e.ja), kana = norm(e.kana), ro = deMacron(e.ro);
        const hit = (field: string, base: number) => {
          if (!field || !q) return;
          if (field === q) s = Math.max(s, base);
          else if (field.startsWith(q)) s = Math.max(s, base - 15);
          else if (q.length >= 2 && field.includes(q)) s = Math.max(s, base - 30);
        };
        hit(ja, 100);
        hit(kana, 96);
        if (qKana) {
          if (kana === qKana || ja === qKana) s = Math.max(s, 94);
          else if (qKana.length >= 2 && (kana.startsWith(qKana) || ja.startsWith(qKana))) s = Math.max(s, 78);
        }
        if (qRo && ro) {
          if (ro === qRo) s = Math.max(s, 95);
          else if (qRo.length >= 3 && ro.startsWith(qRo)) s = Math.max(s, 76);
        }
        for (const a of e.al ?? []) hit(norm(a), 88);
        for (const m of [e.zh, e.en]) {
          const mm = norm(m);
          if (!mm) continue;
          if (mm === q) s = Math.max(s, 90);
          else if (q.length >= (ascii ? 3 : 1) && mm.includes(q)) s = Math.max(s, ascii ? 55 : 62);
        }
        if (s) scored.push({ e, s: s - RANK[e.t] * 0.5 });
      }
      scored.sort((a, b) => b.s - a.s);
      const top = scored.slice(0, 40);

      // word-by-word breakdown for compound menu names (上タン塩 → 上 + タン + 塩)
      const tokens: { text: string; e?: Entry }[] = [];
      if (!ascii) {
        const src = raw.normalize('NFKC');
        const chars = [...src];
        let i = 0;
        let unknown = '';
        while (i < chars.length) {
          let found: { len: number; e: Entry } | null = null;
          for (let len = Math.min(this.maxLen, chars.length - i); len >= 1; len--) {
            const k = norm(chars.slice(i, i + len).join(''));
            const hitList = k && this.dict.get(k);
            if (hitList) {
              found = { len, e: hitList[0] };
              break;
            }
          }
          if (found) {
            if (unknown) tokens.push({ text: unknown }), (unknown = '');
            tokens.push({ text: chars.slice(i, i + found.len).join(''), e: found.e });
            i += found.len;
          } else {
            unknown += chars[i];
            i++;
          }
        }
        if (unknown) tokens.push({ text: unknown });
      }
      const known = tokens.filter((t) => t.e);
      const showBd = known.length >= 2 || (known.length === 1 && tokens.length > 1);
      bd.hidden = !showBd;
      if (showBd) {
        bd.querySelector('.tokens')!.innerHTML = tokens
          .map((t) =>
            t.e
              ? `<a class="tok k-${t.e.t}" href="${this.url(t.e)}"><span class="tj" lang="ja">${esc(t.text)}</span><span class="tr">${esc(t.e.kana ?? '')}</span><span class="tm">${esc(this.meaning(t.e))}</span></a>`
              : PUNCT.test(t.text) && !t.text.replace(PUNCT, '')
                ? ''
                : `<span class="tok unk"><span class="tj" lang="ja">${esc(t.text)}</span><span class="tm">${esc(this.dataset.unknown ?? '')}</span></span>`,
          )
          .join('<span class="plus" aria-hidden="true">+</span>');
      }

      wrap.hidden = !top.length;
      none.hidden = !!top.length || showBd;
      const labels = JSON.parse(this.dataset.labels ?? '{}');
      this.querySelector('.results')!.innerHTML = top
        .map(
          ({ e }) => `<li><a class="res" href="${this.url(e)}">
            <span class="badge b-${e.t}">${esc(labels[e.t] ?? e.t)}</span>
            <span class="rj mincho" lang="ja">${ruby(e)}</span>
            <span class="rm">${e.ro ? `<span class="romaji">${esc(e.ro)}</span>` : ''}<span class="mean">${esc(this.meaning(e))}</span>${e.sub ? `<span class="sub" lang="ja">${esc(e.sub)}</span>` : ''}</span>
          </a></li>`,
        )
        .join('');
    }
  }
  customElements.define('yk-search', YkSearch);
</script>

<style>
  .page { padding-top: 34px; max-width: 860px; }
  yk-search { display: grid; gap: 14px; }
  .box { display: flex; align-items: center; gap: 12px; padding: 0 18px; height: 62px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line-2); box-shadow: var(--shadow-2); color: var(--ink-3); }
  .box:focus-within { border-color: var(--accent); }
  .box input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font-size: 20px; color: var(--ink); font-family: var(--font-ja); }
  .hint { font-size: 13px; padding-left: 4px; }
  .breakdown, .results-wrap { display: grid; gap: 12px; margin-top: 18px; }
  .breakdown[hidden], .results-wrap[hidden] { display: none; }
  .tokens { display: flex; flex-wrap: wrap; align-items: stretch; gap: 8px; }
  .tokens :global(.tok) { display: grid; gap: 1px; padding: 10px 14px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); text-decoration: none; color: var(--ink); min-width: 64px; border-bottom-width: 3px; }
  .tokens :global(.tok:hover) { border-color: var(--line-2); }
  .tokens :global(.k-cut) { border-bottom-color: var(--sec-beef); }
  .tokens :global(.k-term) { border-bottom-color: var(--accent); }
  .tokens :global(.k-dish) { border-bottom-color: var(--sec-more); }
  .tokens :global(.unk) { border-style: dashed; color: var(--ink-3); }
  .tokens :global(.tj) { font-family: var(--font-mincho); font-weight: 800; font-size: 24px; line-height: 1.3; }
  .tokens :global(.tr) { font-size: 12px; color: var(--ink-3); }
  .tokens :global(.tm) { font-size: 13.5px; color: var(--ink-2); }
  .tokens :global(.plus) { align-self: center; color: var(--ink-3); font-size: 18px; }
  .results { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .results :global(.res) { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 2px 16px; padding: 14px 4px; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); align-items: baseline; }
  .results :global(.res:hover) { background: var(--surface-2); }
  .results :global(.badge) { grid-row: span 2; align-self: center; justify-self: start; font-size: 11.5px; padding: 3px 8px; border-radius: 6px; background: var(--bg-2); color: var(--ink-2); font-weight: 600; }
  .results :global(.b-cut) { background: color-mix(in srgb, var(--sec-beef) 14%, transparent); color: var(--sec-beef); }
  .results :global(.b-term) { background: var(--accent-soft); color: var(--accent); }
  .results :global(.rj) { font-size: 21px; font-weight: 800; line-height: 1.6; }
  .results :global(.rm) { display: flex; flex-wrap: wrap; gap: 2px 12px; align-items: baseline; font-size: 14px; color: var(--ink-2); }
  .results :global(.sub) { color: var(--ink-3); font-size: 12.5px; }
  .none[hidden] { display: none; }
  @media (max-width: 520px) {
    .box input { font-size: 17px; }
    .results :global(.res) { grid-template-columns: 1fr; }
    .results :global(.badge) { grid-row: auto; }
  }
</style>
