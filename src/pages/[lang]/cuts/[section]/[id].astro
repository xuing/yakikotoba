---
import Base from '../../../../layouts/Base.astro';
import JaWord from '../../../../components/JaWord.astro';
import Ruby from '../../../../components/Ruby.astro';
import AudioButton from '../../../../components/AudioButton.astro';
import AnatomyMap from '../../../../components/AnatomyMap.astro';
import Photo from '../../../../components/Photo.astro';
import Profile from '../../../../components/Profile.astro';
import CutCard from '../../../../components/CutCard.astro';
import { Picture } from 'astro:assets';
import { locales, pick, t, href, htmlLang, type Locale } from '../../../../i18n/ui';
import {
  getCuts, getCut, sectionOf, slugOf, sectionInfo, cutNumber, locateCut, chainItemsFor,
  getTerm, chainUrl, termUrl, sectionUrl, getMaps, cutUrl, cutsIn,
} from '../../../../lib/content';
import { photosFor, imageByName, logoFor } from '../../../../lib/media';
import { rubyToKana } from '../../../../lib/ruby';

export async function getStaticPaths() {
  const cuts = await getCuts();
  return locales.flatMap((lang) => cuts.map((cut) => ({ params: { lang, section: sectionOf(cut), id: slugOf(cut) }, props: { cut } })));
}

const { cut } = Astro.props;
const locale = Astro.params.lang as Locale;
const d = cut.data;
const section = sectionOf(cut);
const sec = sectionInfo(section)!;
const no = await cutNumber(cut);
const photos = photosFor(`cuts/${cut.id}`);
const locations = await locateCut(cut);
const maps = await getMaps();
const atChains = await chainItemsFor(cut);
const seasoning = (await Promise.all(d.seasoning.map((id) => getTerm(id)))).filter((x) => !!x);
const related = (await Promise.all(d.related.map((r) => getCut(r)))).filter((x): x is NonNullable<typeof x> => !!x && x.id !== cut.id);
const neighbours = related.length ? related : (await cutsIn(section)).filter((c) => c.id !== cut.id).slice(Math.max(0, no - 3), Math.max(0, no - 3) + 4);
const name = pick(d.name, locale);
const aka = [...(d.aka?.ja ?? []), ...((locale === 'zh' ? d.aka?.zh : d.aka?.en) ?? [])];
const variants = d.variants.map((v) => (typeof v === 'string' ? v : v.ja));
const tags: string[] = [];
if (d.rarity === 'rare') tags.push(t(locale, 'rarity.rare'));
if (d.kind === 'offal') tags.push(t(locale, 'kind.offal'));
for (const c of d.cuisines) tags.push(t(locale, `cuisine.${c}` as any) || c);
const yakitoriHint = d.yakitori?.seasoning ? t(locale, `yakitori.${d.yakitori.seasoning}` as any) : '';
const mapTitle = (id: string) => {
  const m = maps.find((x) => x.id === id);
  return m?.data.title ? (m.data.title as any)[locale] ?? m.data.title.ja ?? id : id;
};
---
<Base locale={locale} title={`${d.ja}（${name}）`} description={pick(d.summary, locale) || name} path={`cuts/${cut.id}/`} nav="cuts">
  <div class="wrap page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={href(locale, 'cuts')}>{t(locale, 'nav.cuts')}</a>
      <span aria-hidden="true">/</span>
      <a href={sectionUrl(locale, section)}><span lang="ja">{sec.ja}</span> · {locale === 'zh' ? sec.zh : sec.en}</a>
    </nav>

    <header class="head">
      <div class="no num" style={`--sec: var(--sec-${section})`}><span class="dot"></span>{sec.ja} · No.{String(no).padStart(2, '0')}</div>
      <JaWord ja={d.ja} ruby={d.ruby} kana={d.kana} romaji={d.romaji} tts={d.tts} audioKey={`cut:${cut.id}`} locale={locale} size="xl" as="h1" />
      <p class="name">{name}{d.kanji && d.kanji !== d.ja && <span class="kanji mincho" lang="ja">（{d.kanji}）</span>}</p>
      {d.summary && <p class="summary">{pick(d.summary, locale)}</p>}
      {(tags.length > 0 || yakitoriHint) && (
        <div class="tags">
          {tags.map((x) => <span class="tag">{x}</span>)}
          {yakitoriHint && <span class="tag accent">{yakitoriHint}</span>}
        </div>
      )}
    </header>

    <div class="grid">
      <section class="where card" aria-labelledby="where-h">
        <h2 id="where-h" class="eyebrow">{t(locale, 'cut.where')}</h2>
        {locations.length > 0 ? (
          locations.map((loc) => {
            const map = maps.find((m) => m.id === loc.map)!;
            return (
              <div class="map-block">
                <AnatomyMap
                  map={loc.map}
                  markers={map.data.markers}
                  active={loc.markers.map((m) => String(m.n))}
                  regions={loc.regions.map((r) => r.id)}
                  label={`${d.ja} — ${mapTitle(loc.map)}`}
                />
                <p class="map-cap"><span class="mincho" lang="ja">{mapTitle(loc.map)}</span>{loc.markers.map((m) => <span class="mk-label"><span class="pin"></span><span lang="ja">{m.n}. {m.label}</span></span>)}</p>
              </div>
            );
          })
        ) : (
          <p class="faint">{t(locale, 'cut.noMap')}</p>
        )}
        {d.location && <p class="location">{pick(d.location, locale)}</p>}
      </section>

      <section class="photos" aria-label={t(locale, 'cut.photo')}>
        {photos.length > 0 ? (
          photos.slice(0, 3).map((p, i) => <Photo item={p} locale={locale} alt={`${d.ja} ${name}`} loading={i === 0 ? 'eager' : 'lazy'} />)
        ) : (
          <div class="no-photo card"><span class="mincho glyph" lang="ja">{d.ja.slice(0, 1)}</span><span class="faint">{t(locale, 'cut.noPhoto')}</span></div>
        )}
      </section>
    </div>

    <div class="facts">
      {d.profile && (
        <section class="fact span2">
          <h2 class="eyebrow">{t(locale, 'cut.texture')}</h2>
          <Profile profile={d.profile} locale={locale} />
          {d.texture && <p>{pick(d.texture, locale)}</p>}
        </section>
      )}
      {!d.profile && d.texture && (
        <section class="fact">
          <h2 class="eyebrow">{t(locale, 'cut.texture')}</h2>
          <p>{pick(d.texture, locale)}</p>
        </section>
      )}
      {d.grill && (
        <section class="fact">
          <h2 class="eyebrow">{t(locale, 'cut.grill')}</h2>
          <p>{pick(d.grill, locale)}</p>
          {seasoning.length > 0 && (
            <p class="with">
              <span class="faint">{t(locale, 'cut.seasoning')}</span>
              {seasoning.map((s) => <a class="chip" href={termUrl(locale, s!.id)}><span lang="ja"><Ruby text={s!.data.ja} ruby={s!.data.ruby} /></span><span class="faint">{pick(s!.data.name, locale)}</span></a>)}
            </p>
          )}
        </section>
      )}
      {d.etymology && (
        <section class="fact">
          <h2 class="eyebrow">{t(locale, 'cut.etymology')}</h2>
          <p>{pick(d.etymology, locale)}</p>
        </section>
      )}
      {(variants.length > 0 || aka.length > 0) && (
        <section class="fact">
          {variants.length > 0 && (
            <>
              <h2 class="eyebrow">{t(locale, 'cut.variants')}</h2>
              <p class="chips">{variants.map((v) => <a class="chip" href={`${href(locale, 'search')}?q=${encodeURIComponent(v)}`} lang="ja">{v}</a>)}</p>
            </>
          )}
          {aka.length > 0 && (
            <>
              <h2 class="eyebrow" style="margin-top:18px">{t(locale, 'cut.aka')}</h2>
              <p class="chips">{aka.map((v) => <span class="chip plain">{v}</span>)}</p>
            </>
          )}
        </section>
      )}
      {d.example && (
        <section class="fact example span2">
          <h2 class="eyebrow">{t(locale, 'cut.example')}</h2>
          <div class="ex">
            <AudioButton audioKey={`example:${cut.id}`} text={d.example.kana ?? (d.example.ruby ? rubyToKana(d.example.ruby) : d.example.ja)} locale={locale} />
            <div>
              <p class="ex-ja mincho" lang="ja"><Ruby text={d.example.ja} ruby={d.example.ruby} /></p>
              <p class="ex-tr">{locale === 'zh' ? d.example.zh ?? d.example.en : d.example.en ?? d.example.zh}</p>
            </div>
          </div>
        </section>
      )}
    </div>

    {atChains.length > 0 && (
      <section class="block">
        <div class="section-title"><h2>{t(locale, 'cut.atChains')}</h2></div>
        <div class="chain-items">
          {atChains.map(({ chain, item }) => {
            const img = imageByName(`chains/${chain.id}`, item.image);
            const logo = logoFor(`chains/${chain.id}`);
            return (
              <a class="card ci" href={`${chainUrl(locale, chain)}#${item.id}`}>
                {img && !img.isSvg && <Picture src={img.image} alt="" formats={['avif']} fallbackFormat="webp" widths={[240, 480]} sizes="120px" class="ci-img" />}
                <div class="ci-text">
                  <span class="ci-chain">{logo ? <img src={logo.image.src} alt="" class="ci-logo" /> : null}<span lang="ja">{chain.data.ja}</span>{item.signature && <span class="tag accent">{t(locale, 'chain.signature')}</span>}</span>
                  <span class="ci-ja mincho" lang="ja"><Ruby text={item.ja} ruby={item.ruby} /></span>
                  {item.name && <span class="faint">{pick(item.name, locale)}</span>}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {neighbours.length > 0 && (
      <section class="block">
        <div class="section-title"><h2>{t(locale, 'cut.related')}</h2></div>
        <div class="cards">{neighbours.map((c) => <CutCard cut={c} locale={locale} />)}</div>
      </section>
    )}

    {d.sources.length > 0 && (
      <section class="sources">
        <h2 class="eyebrow">{t(locale, 'cut.sources')}</h2>
        <ul>{d.sources.map((s) => <li>{s.url ? <a href={s.url} rel="noopener">{s.title ?? s.url}</a> : s.title}</li>)}</ul>
      </section>
    )}
  </div>
</Base>

<style>
  .page { padding-top: 22px; }
  .crumbs { display: flex; gap: 8px; font-size: 14px; color: var(--ink-3); margin-bottom: 26px; }
  .crumbs a { color: var(--ink-2); text-decoration: none; }
  .crumbs a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }

  .head { display: grid; gap: 12px; margin-bottom: 32px; max-width: 760px; }
  .no { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; letter-spacing: .12em; color: var(--ink-3); font-weight: 600; }
  .no .dot { color: var(--sec); }
  .name { font-size: clamp(20px, 2.6vw, 26px); font-weight: 600; letter-spacing: .01em; }
  .kanji { color: var(--ink-3); font-weight: 500; }
  .summary { color: var(--ink-2); font-size: 17px; max-width: 46em; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }

  .grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: 20px; align-items: start; }
  .where { padding: 20px 22px 22px; display: grid; gap: 14px; }
  .map-block { display: grid; gap: 8px; }
  .map-cap { display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: center; font-size: 13.5px; color: var(--ink-2); }
  .mk-label { display: inline-flex; align-items: center; gap: 6px; }
  .pin { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); }
  .location { font-size: 15.5px; border-top: 1px solid var(--line); padding-top: 12px; }
  .photos { display: grid; gap: 16px; }
  .no-photo { aspect-ratio: 4 / 3; display: grid; place-content: center; justify-items: center; gap: 4px; font-size: 13px; }
  .glyph { font-size: 72px; font-weight: 800; color: var(--line-2); line-height: 1; }

  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 40px; margin-top: 36px; }
  .fact { padding-block: 22px; border-top: 1px solid var(--line); display: grid; gap: 10px; align-content: start; }
  .fact p { font-size: 15.5px; }
  .span2 { grid-column: 1 / -1; }
  .with { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; font-size: 14px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip.plain { background: transparent; }
  .ex { display: flex; gap: 14px; align-items: flex-start; }
  .ex-ja { font-size: 22px; font-weight: 700; line-height: 1.9; }
  .ex-tr { color: var(--ink-2); }

  .block { margin-top: 48px; }
  .chain-items { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
  .ci { display: flex; gap: 14px; padding: 12px; align-items: center; color: var(--ink); }
  .ci :global(.ci-img) { width: 92px; height: 92px; object-fit: cover; border-radius: 10px; flex-shrink: 0; background: var(--surface-2); }
  .ci-text { display: grid; gap: 4px; min-width: 0; font-size: 13.5px; }
  .ci-chain { display: flex; align-items: center; gap: 8px; color: var(--ink-2); font-size: 12.5px; }
  .ci-logo { height: 18px; width: auto; max-width: 72px; object-fit: contain; }
  .ci-ja { font-size: 17px; font-weight: 700; line-height: 1.5; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; }
  .sources { margin-top: 48px; font-size: 13px; color: var(--ink-3); display: grid; gap: 8px; }
  .sources ul { padding-left: 1.2em; display: grid; gap: 2px; }
  .sources a { color: var(--ink-2); }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    .facts { grid-template-columns: 1fr; }
  }
</style>
