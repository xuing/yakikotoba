---
import Base from '../../../layouts/Base.astro';
import SectionTiles from '../../../components/SectionTiles.astro';
import { locales, t, type Locale } from '../../../i18n/ui';

export const getStaticPaths = () => locales.map((lang) => ({ params: { lang } }));
const locale = Astro.params.lang as Locale;
---
<Base locale={locale} title={t(locale, 'cuts.title')} path="cuts/" nav="cuts">
  <div class="wrap page">
    <header class="head">
      <h1 class="mincho">{t(locale, 'cuts.title')}</h1>
      <p class="muted">{t(locale, 'cuts.lead')}</p>
    </header>
    <SectionTiles locale={locale} />
  </div>
</Base>
<style>
  .page { padding-top: 34px; }
  .head { margin-bottom: 26px; display: grid; gap: 6px; }
  h1 { font-size: clamp(34px, 5vw, 48px); font-weight: 800; letter-spacing: .03em; }
</style>
