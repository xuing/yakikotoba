---
import Base from '../../layouts/Base.astro';
import SectionTiles from '../../components/SectionTiles.astro';
import CutCard from '../../components/CutCard.astro';
import Ruby from '../../components/Ruby.astro';
import { locales, pick, t, href, type Locale } from '../../i18n/ui';
import { getChains, getCut, getTerms, getPhraseScenes, chainUrl, termUrl } from '../../lib/content';
import { logoFor } from '../../lib/media';

export const getStaticPaths = () => locales.map((lang) => ({ params: { lang } }));
const locale = Astro.params.lang as Locale;

const featuredRefs = ['beef/tan', 'beef/karubi', 'beef/harami', 'beef/misuji', 'horumon/mino', 'horumon/shimacho', 'chicken/bonjiri', 'chicken/seseri'];
const featured = (await Promise.all(featuredRefs.map((r) => getCut(r)))).filter((c): c is NonNullable<typeof c> => !!c);
const chains = await getChains();
const terms = (await getTerms()).filter((x) => ['jo', 'tokujo', 'shio', 'tare', 'ninmae', 'hon', 'kisho-bui', 'tabehodai', 'atsugiri', 'moriawase'].includes(x.id));
const scenes = await getPhraseScenes();
const firstPhrases = scenes.flatMap((s) => s.data.phrases.slice(0, 1).map((p) => ({ s, p }))).slice(0, 4);
const examples = ['上タン塩', 'ハラミ', 'ぼんじり', '特選ミノ', 'karubi', locale === 'zh' ? '牛舌' : 'tongue'];
---
<Base locale={locale} nav="home">
  <section class="hero">
    <div class="wrap hero-in">
      <h1 class="mincho" lang="ja">焼肉と焼き鳥の、<br />ことば。</h1>
      <p class="lead">{t(locale, 'site.description')}</p>
      <form class="search" action={href(locale, 'search')} method="get" role="search">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg>
        <input name="q" type="search" autocomplete="off" placeholder={t(locale, 'search.placeholder')} aria-label={t(locale, 'nav.search')} />
      </form>
      <p class="examples">{examples.map((e) => <a class="chip" href={`${href(locale, 'search')}?q=${encodeURIComponent(e)}`}><span lang={/^[a-z]+$/i.test(e) ? 'en' : 'ja'}>{e}</span></a>)}</p>
    </div>
  </section>

  <div class="wrap">
    <section class="block">
      <div class="section-title"><h2>{t(locale, 'home.cuts')}</h2><a class="more" href={href(locale, 'cuts')}>→</a></div>
      <SectionTiles locale={locale} />
    </section>

    {featured.length > 0 && (
      <section class="block">
        <div class="section-title"><h2>{t(locale, 'home.popular')}</h2></div>
        <div class="cards">{featured.map((c) => <CutCard cut={c} locale={locale} />)}</div>
      </section>
    )}

    {chains.length > 0 && (
      <section class="block">
        <div class="section-title"><h2>{t(locale, 'home.chains')}</h2><a class="more" href={href(locale, 'chains')}>→</a></div>
        <div class="logos">
          {chains.map((ch) => {
            const logo = logoFor(`chains/${ch.id}`);
            return (
              <a class="card lg" href={chainUrl(locale, ch)} title={ch.data.ja}>
                {logo ? <img src={logo.image.src} alt={ch.data.ja} loading="lazy" /> : <span class="mincho" lang="ja">{ch.data.ja}</span>}
              </a>
            );
          })}
        </div>
      </section>
    )}

    <div class="duo">
      {terms.length > 0 && (
        <section class="block">
          <div class="section-title"><h2>{t(locale, 'home.words')}</h2><a class="more" href={href(locale, 'words')}>→</a></div>
          <ul class="words">
            {terms.map((x) => (
              <li><a href={termUrl(locale, x.id)}><span class="wj mincho" lang="ja"><Ruby text={x.data.ja} ruby={x.data.ruby} /></span><span class="wm">{pick(x.data.name, locale)}</span></a></li>
            ))}
          </ul>
        </section>
      )}
      {firstPhrases.length > 0 && (
        <section class="block">
          <div class="section-title"><h2>{t(locale, 'home.phrases')}</h2><a class="more" href={href(locale, 'phrases')}>→</a></div>
          <ul class="phr">
            {firstPhrases.map(({ s, p }) => (
              <li><a href={`${href(locale, 'phrases')}#${s.id}-${p.id}`}><span class="pj mincho" lang="ja"><Ruby text={p.ja} ruby={p.ruby} /></span><span class="pm">{locale === 'zh' ? p.zh ?? p.en : p.en ?? p.zh}</span></a></li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</Base>

<style>
  .hero { padding: clamp(48px, 9vw, 104px) 0 clamp(36px, 6vw, 64px); border-bottom: 1px solid var(--line); background:
    radial-gradient(1200px 400px at 85% -10%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 70%); }
  .hero-in { display: grid; gap: 22px; max-width: 880px; }
  h1 { font-size: clamp(42px, 8.4vw, 92px); font-weight: 800; line-height: 1.12; letter-spacing: .02em; }
  .lead { font-size: clamp(16px, 2vw, 19px); color: var(--ink-2); max-width: 36em; }
  .search { display: flex; align-items: center; gap: 12px; padding: 0 18px; height: 62px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line-2); box-shadow: var(--shadow-2); color: var(--ink-3); max-width: 640px; }
  .search:focus-within { border-color: var(--accent); }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font-size: 18px; color: var(--ink); font-family: var(--font-ja); }
  .examples { display: flex; flex-wrap: wrap; gap: 6px; }
  .block { margin-top: 56px; }
  .section-title { justify-content: space-between; }
  .more { text-decoration: none; color: var(--ink-3); font-size: 20px; padding: 0 6px; }
  .more:hover { color: var(--accent); }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; }
  .logos { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .lg { display: grid; place-items: center; height: 92px; padding: 14px 18px; background: #fff; color: #1d1a16; font-weight: 700; }
  .lg img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: 0 40px; }
  .words { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .words a { display: flex; align-items: baseline; gap: 10px; padding: 10px 14px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); text-decoration: none; color: var(--ink); }
  .words a:hover { border-color: var(--line-2); }
  .wj { font-size: 20px; font-weight: 800; }
  .wm { font-size: 13.5px; color: var(--ink-2); }
  .phr { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .phr a { display: grid; gap: 2px; padding: 12px 2px; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); }
  .pj { font-size: 19px; font-weight: 700; line-height: 1.9; }
  .pm { font-size: 14px; color: var(--ink-2); }
  @media (max-width: 860px) { .duo { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .cards { grid-template-columns: 1fr 1fr; gap: 10px; } .search input { font-size: 16px; } }
</style>
