---
import Base from '../../../layouts/Base.astro';
import { locales, t, type Locale } from '../../../i18n/ui';
import { getChains, chainUrl } from '../../../lib/content';
import { logoFor } from '../../../lib/media';

export const getStaticPaths = () => locales.map((lang) => ({ params: { lang } }));
const locale = Astro.params.lang as Locale;
const chains = await getChains();
const groups = (['yakiniku', 'yakitori'] as const)
  .map((c) => ({ c, list: chains.filter((x) => (x.data.cuisine === 'yakitori' ? 'yakitori' : 'yakiniku') === c) }))
  .filter((g) => g.list.length);
---
<Base locale={locale} title={t(locale, 'chains.title')} path="chains/" nav="chains">
  <div class="wrap page">
    <header class="head">
      <h1 class="mincho">{t(locale, 'chains.title')}</h1>
      <p class="muted">{t(locale, 'chains.lead')}</p>
    </header>
    {groups.map((g) => (
      <section class="group">
        <div class="section-title"><h2 lang="ja">{g.c === 'yakiniku' ? '焼肉' : '焼き鳥'}</h2><span class="sub">{t(locale, `cuisine.${g.c}`)}</span></div>
        <div class="grid">
          {g.list.map((ch) => {
            const logo = logoFor(`chains/${ch.id}`);
            const sig = ch.data.items.filter((i) => i.signature).slice(0, 3);
            return (
              <a class="card ch" href={chainUrl(locale, ch)}>
                <span class="lg">{logo ? <img src={logo.image.src} alt="" loading="lazy" /> : <span class="mincho ph" lang="ja">{ch.data.ja.slice(0, 2)}</span>}</span>
                <span class="tx">
                  <span class="ja mincho" lang="ja">{ch.data.ja}</span>
                  <span class="romaji">{ch.data.brand ?? ch.data.romaji}</span>
                  {ch.data.format && <span class="fmt">{t(locale, `chain.format.${ch.data.format}` as any) || ch.data.format}</span>}
                  {sig.length > 0 && <span class="sig" lang="ja">{sig.map((s) => s.ja).join('・')}</span>}
                </span>
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Base>
<style>
  .page { padding-top: 34px; }
  .head { margin-bottom: 30px; display: grid; gap: 6px; }
  h1 { font-size: clamp(34px, 5vw, 48px); font-weight: 800; letter-spacing: .03em; }
  .group { margin-bottom: 40px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
  .ch { display: grid; grid-template-columns: 92px 1fr; gap: 16px; padding: 16px; align-items: center; color: var(--ink); }
  .lg { width: 92px; height: 92px; border-radius: 16px; background: #fff; border: 1px solid var(--line); display: grid; place-items: center; padding: 10px; }
  .lg img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .ph { font-size: 26px; font-weight: 800; color: #8c8376; }
  .tx { display: grid; gap: 2px; min-width: 0; }
  .ja { font-size: 21px; font-weight: 800; line-height: 1.35; }
  .romaji { font-size: 14px; }
  .fmt { font-size: 12.5px; color: var(--ink-2); margin-top: 4px; }
  .sig { font-size: 12.5px; color: var(--ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
