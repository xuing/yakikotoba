# Google Gemini API key (required for /api/scan menu recognition and `npm run tts`)
# Supports a single key, a JSON array, or comma-separated keys for automatic rotation & 429 failover:
#   GEMINI_API_KEY=your-key
#   GEMINI_API_KEY=["key1","key2","key3"]
#   GEMINI_API_KEY=key1,key2,key3
GEMINI_API_KEY=

# Optional model overrides
# GEMINI_SCAN_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Kore

# Optional public site URL for canonical and OpenGraph links (defaults to https://yakikotoba.pages.dev)
# PUBLIC_SITE_URL=https://yakikotoba.pages.dev
